# ===========================================================================
# EVE Netboot Installer VM - settings reference (KEY=VALUE syntax)
#
# Use this file as the cloud-init user-data of the VM (ZEDEDA custom
# configuration, Proxmox cicustom, libvirt --cloud-init, ...). The VM then
# sets itself up at first boot, without the setup menu on its screen.
#
# Syntax
#   KEY=VALUE        one setting per line, no spaces around "="
#   # comment        comments only on their own line
#   KEY="a #b"       quotes when a value contains " #" (otherwise the rest
#                    of the line counts as a comment)
#   KEY=             empty, or the line left out = the default
#
# Every line below that is not commented out shows the DEFAULT value, so this
# file as it is gives a working VM with DHCP and default settings. Uncomment
# and change what you need; delete what you do not.
#
# Applied at the first boot and again whenever the user-data changes; only
# the settings in the user-data are changed then. The same names work in
# the "eve_netboot:" section of a #cloud-config (cloud-config.yaml) and in
# /etc/eve-netboot/settings.env inside the VM.
#
# Names: ENI_* = EVE Netboot Installer itself; EVE_* = EVE-OS (which
# releases are mirrored, EVE_DEFAULT_* = defaults of its installation
# options); the rest configure the VM. The pre-1.3 names of the ENI_*
# settings (EVE_LANGUAGE instead of ENI_LANGUAGE, ...) still work.
# ===========================================================================

# ---------------------------------------------------------------- access --
# Password of the user "admin" (VM screen menu, SSH). At least 8 characters.
# Applied and then forgotten: never stored in the VM's settings.
# ADMIN_PASSWORD=Change-Me-Please-1
#
# The same as a hash, so the password is not readable in the user-data.
# Make it with:  openssl passwd -6
# ADMIN_PASSWORD_HASH=$6$rounds=5000$examplesalt$examplehash
#
# SSH public key(s) for "admin"; several separated by ";"
# ADMIN_SSH_KEYS=ssh-ed25519 AAAAC3Nza... you@laptop; ssh-rsa AAAAB3Nza... other@desk
#
# SSH login with the password: yes | no  (with no, only SSH keys work)
SSH_PASSWORD_LOGIN=yes

# -------------------------------------------------------------- this VM --
# Host name of the VM (letters, digits, "-")
HOSTNAME=eve-netboot
# Time zone, e.g. Europe/Amsterdam (also used in the logs of the PXE server)
TZ=UTC

# --------------------------------------------------------------- network --
# dhcp   = address from your DHCP server (use a DHCP reservation for the VM's
#          MAC address, so the address never changes)
# static = fixed address, set below
NET_MODE=dhcp
#
# Only with NET_MODE=static:
# address with prefix length
# NET_ADDRESS=192.168.1.20/24
# default gateway; empty = none (e.g. an isolated PXE network)
# NET_GATEWAY=192.168.1.1
# DNS servers, separated by spaces
# NET_DNS=192.168.1.1 1.1.1.1
# network adapter that gets the address; empty = the first one (other
# adapters keep using DHCP). Only needed with more than one adapter.
# NET_INTERFACE=enp0s1

# -------------------------------------------------------- web management --
# Manage this VM in a web browser: https://<VM address>:8443/ (login with the
# admin password; the browser warns once about the self-signed certificate).
# yes | no. Default yes; a VM set up on its console starts with no.
WEB_ADMIN=yes
# TCP port of the web management (not HTTP_PORT, not 69)
# WEB_ADMIN_PORT=8443

# ---------------------------------------------------------- import share --
# Share the folder for your own installer ISOs as \\<VM address>\eve-import
# (SMB, user "admin"): yes | no
SMB_IMPORT_SHARE=no
# Password of that share. Applied and then forgotten.
# SMB_PASSWORD=Another-Password-1

# ---------------------------------------------------------- DHCP service --
# Let the VM answer DHCP itself, so no DHCP server has to be changed.
#   off     default: set next-server and the boot file on your DHCP server
#   proxy   only the network boot answers (proxyDHCP), next to the DHCP server
#           the network already has; it keeps handing out the addresses
#   server  all of DHCP, for a network without a DHCP server of its own; needs
#           NET_MODE=static. Never next to another DHCP server.
DHCP_MODE=off
# The settings below may stay empty: they then follow the VM's own network.
# Adapter the machines boot on; empty = the VM's adapter
# DHCP_INTERFACE=enp0s1
# server only: address range; empty = a block of the VM's network clear of its
# own address and the gateway (for 192.168.1.20/24: .128 - .254)
# DHCP_RANGE_START=192.168.1.100
# DHCP_RANGE_END=192.168.1.199
# server only: gateway and DNS servers for the machines; empty = the VM's own,
# none = none
# DHCP_GATEWAY=192.168.1.1
# DHCP_DNS=192.168.1.1 1.1.1.1
# server only: lease time
# DHCP_LEASE_TIME=12h

# ============================================================ PXE server ==
# The same settings as .env.example of a Docker Compose installation.

# Address the PXE clients use to reach the VM: auto = the VM's own address
SERVER_IP=auto
# TCP port of the status page and the boot menu (not 69)
HTTP_PORT=8080
# Interface address the HTTP port listens on; empty = all
# HTTP_BIND=
# Address:port of the TFTP server; empty = 0.0.0.0:69
# TFTP_LISTEN=
# Name of the import folder in the boot menu and on the status page
ENI_IMPORT_LABEL=import share

# ---------------------------------------------------------- boot menu --
# Language: en de fr es pt nl da no
ENI_LANGUAGE=en
# standalone = this is the top-level boot menu ("exit" boots the local disk)
# chained    = called from another iPXE menu ("exit" goes back to it)
ENI_MENU_MODE=standalone
# Seconds without a key press before the menu boots the local disk
# (standalone) or goes back (chained); 0 = wait forever.
# Empty = 300 standalone, 0 chained.
# ENI_MENU_TIMEOUT=300

# ------------------------------------------------------ GitHub mirror --
# Architectures of the machines you install: amd64, arm64 or "amd64 arm64"
EVE_ARCHES=amd64
# EVE-OS variants: kvm, k (with Kubernetes, >= 8 GB RAM) or "kvm k"
EVE_FLAVOURS=kvm
# How many EVE-OS LTS release lines to mirror (newest patch of each);
# about 0.5 GB per line, architecture and variant
EVE_LTS_LINES=3
# Seconds between GitHub checks: 86400 = daily, 0 = only at start
# ENI_SYNC_INTERVAL=86400
# Seconds between scans of the import folder
# ENI_IMPORT_INTERVAL=60
# Repository the releases come from
# EVE_GITHUB_REPO=lf-edge/eve
# Only when the anonymous GitHub API limit is hit (shared public IP):
# a fine-grained token without permissions. Not included in exports.
# ENI_GITHUB_TOKEN=github_pat_...

# --------------------------- defaults of the installation options --
# (all can still be changed in the boot menu before installing)
# Reboot after the installation: 1 | 0
# EVE_DEFAULT_REBOOT=1
# Soft serial number = the MAC address of the machine: 1 | 0
# EVE_DEFAULT_SOFT_SERIAL=1
# Wipe ALL disks of the machine, not only the target disk: 1 | 0
# EVE_DEFAULT_NUKE_ALL_DISKS=0
# Serial console: none | ttyS0 | ttyS1 | ttyAMA0
# EVE_DEFAULT_SERIAL=none
# Target disk, kernel name without /dev/ (e.g. sda, nvme0n1); empty = the
# installer decides
# EVE_DEFAULT_INSTALL_DISK=
# Disk(s) for /persist, comma separated (several = ZFS); empty = target disk
# EVE_DEFAULT_PERSIST_DISK=
# Controller the installed nodes connect to; empty = what is in the ISO
# EVE_DEFAULT_INSTALL_SERVER=zedcloud.zededa.net
# Extra kernel parameters for the installer
# EVE_DEFAULT_EXTRA_ARGS=

# ------------------------------------------------------------------ iPXE --
# Extra file names for the iPXE binaries (e.g. the boot file name your DHCP
# server already hands out), separated by spaces
# IPXE_ALIASES_X86_64=ipxe.efi
# IPXE_ALIASES_ARM64=

# -------------------------------------------------- application image --
# Normally managed by the VM ("Update EVE Netboot Installer" in the menu).
# Setting it pins a version and switches those updates off.
# ENI_IMAGE=ghcr.io/michiel-zededa/eve-netboot-installer:1.6.0

# Fixed in the VM and ignored: DATA_DIR, IMPORT_DIR, ENI_SRC_DIR
