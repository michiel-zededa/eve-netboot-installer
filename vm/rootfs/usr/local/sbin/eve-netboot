import ipaddress
import itertools
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

# --------------------------------------------------------------------------
# paths and constants
# --------------------------------------------------------------------------
ETC = os.environ.get("ENI_ETC", "/etc/eve-netboot")
SETTINGS = os.path.join(ETC, "settings.env")
CONFIGURED = os.path.join(ETC, ".configured")
KEYS_DIR = os.path.join(ETC, "authorized_keys")
LIB = "/usr/local/lib/eve-netboot"
STATE = "/var/lib/eve-netboot"
STACK = "/opt/eve-netboot"
DATA = "/srv/eve-netboot"
IMPORT = os.path.join(DATA, "import")
WWW = os.path.join(DATA, "www")
LOG = "/var/log/eve-netboot.log"
LOCK = "/run/eve-netboot.lock"
BOOT_DONE = "/run/eve-netboot.boot-done"   # written when "eve-netboot boot" has finished
USERDATA = "/var/lib/cloud/instance/user-data.txt"
NETWORKD = "/etc/systemd/network"
NET_STATIC = os.path.join(NETWORKD, "10-eve-netboot-static.network")
NET_DHCP = os.path.join(NETWORKD, "20-eve-netboot.network")
SSHD_CONF = "/etc/ssh/sshd_config.d/10-eve-netboot.conf"
SMB_CONF = "/etc/samba/smb.conf"
DNSMASQ_CONF = os.path.join(ETC, "dnsmasq.conf")
DHCP_LEASES = "/var/lib/misc/dnsmasq.leases"
DHCP_UNIT = "eve-netboot-dhcp.service"
DHCP_MODES = ("off", "proxy", "server")
ADMIN = "admin"
PRODUCT = "EVE Netboot Installer"
REPO = "michiel-zededa/eve-netboot-installer"
IMAGE_REPO = f"ghcr.io/{REPO}"
LANGUAGES = [("en", "English"), ("de", "Deutsch"), ("fr", "Français"), ("es", "Español"),
             ("pt", "Português"), ("nl", "Nederlands"), ("da", "Dansk"), ("no", "Norsk")]
SERIALS = ["none", "ttyS0", "ttyS1", "ttyAMA0"]

# settings that configure the VM itself; everything else goes to the stack's .env
VM_KEYS = {"HOSTNAME", "NET_MODE", "NET_INTERFACE", "NET_ADDRESS", "NET_GATEWAY", "NET_DNS",
           "ADMIN_PASSWORD", "ADMIN_PASSWORD_HASH", "ADMIN_SSH_KEYS", "SSH_PASSWORD_LOGIN",
           "SMB_IMPORT_SHARE", "SMB_PASSWORD", "WEB_ADMIN", "WEB_ADMIN_PORT",
           "DHCP_MODE", "DHCP_INTERFACE", "DHCP_RANGE_START", "DHCP_RANGE_END", "DHCP_GATEWAY", "DHCP_DNS",
           "DHCP_LEASE_TIME"}
# applied once and never stored
CONSUMED = {"ADMIN_PASSWORD", "ADMIN_PASSWORD_HASH", "SMB_PASSWORD"}
# not in an export (secrets)
NOT_EXPORTED = CONSUMED | {"ENI_GITHUB_TOKEN", "GITHUB_TOKEN"}
# fixed by the appliance; ignored when set
FIXED = {"DATA_DIR", "IMPORT_DIR", "ENI_SRC_DIR", "SERVER_IP_DETECTED"}

DEFAULTS = {
    "HOSTNAME": "eve-netboot",
    "NET_MODE": "dhcp",
    "SSH_PASSWORD_LOGIN": "yes",
    "SMB_IMPORT_SHARE": "no",
    # web management over HTTPS; switched off when the setup was done on the console
    "WEB_ADMIN": "yes",
    "WEB_ADMIN_PORT": "8443",
    # DHCP service of the VM: off, proxy (only the network boot answers, next to
    # the DHCP server the LAN has) or server (all of DHCP, for an isolated network)
    "DHCP_MODE": "off",
    "DHCP_LEASE_TIME": "12h",
    "SERVER_IP": "auto",
    "HTTP_PORT": "8080",
    "TZ": "UTC",
    "ENI_LANGUAGE": "en",
    "EVE_ARCHES": "amd64",
    "EVE_FLAVOURS": "kvm",
    "EVE_LTS_LINES": "3",
    "ENI_IMPORT_LABEL": "import share",
    # shown as the value when not set (the stack has the same defaults)
    "ENI_SYNC_INTERVAL": "86400",
    "ENI_MENU_MODE": "standalone",
    "EVE_GITHUB_REPO": "lf-edge/eve",
    "EVE_DEFAULT_REBOOT": "1",
    "EVE_DEFAULT_SOFT_SERIAL": "1",
    "EVE_DEFAULT_NUKE_ALL_DISKS": "0",
    "EVE_DEFAULT_SERIAL": "none",
}

KEY_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")

# settings of the installer itself were called EVE_* before 1.3 (EVE_DEFAULT_*,
# the defaults of EVE-OS's installation options, keep their name)
RENAMED = {f"EVE_{n}": f"ENI_{n}" for n in (
    "IMAGE", "SRC_DIR", "LANGUAGE", "MENU_MODE", "MENU_TIMEOUT",
    "SYNC_INTERVAL", "IMPORT_INTERVAL", "IMPORT_LABEL", "GITHUB_TOKEN")}


def migrate(settings):
    """Old EVE_* names -> ENI_*; when both are given, the new name wins."""
    out = {k: v for k, v in settings.items() if k not in RENAMED}
    for old, new in RENAMED.items():
        if old in settings and new not in settings:
            out[new] = settings[old]
    return out


# --------------------------------------------------------------------------
# texts: the same translations as the boot menu and the web UI
# (app/i18n/<lang>.json in the image; a copy on the VM, made at build time).
# ENI_LANGUAGE is the language of the boot menu, the status page and of this
# tool (console and web management); English is the fallback for every key.
# --------------------------------------------------------------------------
I18N_DIRS = [os.path.join(LIB, "i18n"),
             os.path.join(os.path.dirname(os.path.realpath(__file__)), *[".."] * 5, "app", "i18n")]
_texts = {}
_language = None     # chosen in the setup before it is saved
_local = threading.local()   # per web request: the language of the browser


def texts(lang):
    if lang not in _texts:
        out = {}
        for code in dict.fromkeys(("en", lang)):
            for d in I18N_DIRS:
                try:
                    with open(os.path.join(d, f"{code}.json"), encoding="utf-8") as f:
                        out.update({k: v for k, v in json.load(f).items() if v})
                    break
                except (OSError, ValueError):
                    continue
        _texts[lang] = out
    return _texts[lang]


def language():
    if getattr(_local, "language", None):
        return _local.language
    if _language:
        return _language
    lang = get(load_settings(), "ENI_LANGUAGE")
    return lang if lang in dict(LANGUAGES) else "en"


def set_language(lang):
    global _language
    _language = lang


def use_language(lang):
    """The language of this thread only (a web request, a job); None = the saved one."""
    _local.language = lang if lang in dict(LANGUAGES) else None


def thread_language():
    return getattr(_local, "language", None)


def tr(key, /, **values):
    """tr("adm_disk_free", free=3) -> the text in the current language."""
    text = texts(language()).get(key) or texts("en").get(key) or key
    for k, v in values.items():
        text = text.replace("{" + k + "}", str(v))
    return text


# --------------------------------------------------------------------------
# settings: parse, merge, validate, render (pure functions, unit tested)
# --------------------------------------------------------------------------
def parse_env(text):
    """KEY=VALUE lines -> dict. Same rules as docker compose's .env:
    full-line comments, optional quotes, ' #...' after an unquoted value is a comment."""
    out = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        key, sep, value = line.partition("=")
        key = key.strip()
        if not sep or not KEY_RE.match(key):
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        else:
            value = re.split(r"\s+#", value, maxsplit=1)[0].strip()
        out[key] = value
    return migrate(out)


def parse_user_data(text):
    """Settings from cloud-init user-data, or None if it carries none.

    Accepted: plain KEY=VALUE lines, or a #cloud-config with an
    "eve_netboot:" mapping. Scripts, MIME archives etc. are not ours."""
    if not text or not text.strip():
        return None
    first = text.lstrip().splitlines()[0].strip()
    if first.startswith("#cloud-config"):
        try:
            import yaml  # python3-yaml ships with cloud-init
        except ImportError:
            return None
        try:
            doc = yaml.safe_load(text) or {}
        except yaml.YAMLError:
            return None
        section = doc.get("eve_netboot") if isinstance(doc, dict) else None
        if not isinstance(section, dict):
            return None
        out = {}
        for k, v in section.items():
            k = str(k).strip().upper()
            if KEY_RE.match(k) and v is not None:
                if isinstance(v, bool):     # YAML reads yes/no/on/off as booleans
                    out[k] = ("on" if v else "off") if k == "DHCP_MODE" else ("yes" if v else "no")
                else:
                    out[k] = str(v).strip()
        return migrate(out) or None
    if first.startswith("#!") or first.lower().startswith("content-type") or first.startswith("#include"):
        return None
    return parse_env(text) or None


def merge(current, incoming):
    """incoming overrides current; keys in FIXED are dropped."""
    out = dict(current)
    for k, v in incoming.items():
        if k not in FIXED:
            out[k] = v
    return out


def get(settings, key):
    v = settings.get(key, "")
    return v if v != "" else DEFAULTS.get(key, "")


def problems(s):
    """[(setting, human-readable problem)] (empty = fine)."""
    errors = []
    mode = get(s, "NET_MODE")
    if mode not in ("dhcp", "static"):
        errors.append(("NET_MODE", tr("adm_err_net_mode")))
    if mode == "static":
        try:
            iface = ipaddress.ip_interface(get(s, "NET_ADDRESS"))
            if iface.version != 4 or iface.network.prefixlen == 32:
                raise ValueError
        except ValueError:
            errors.append(("NET_ADDRESS", tr("adm_err_net_address")))
            iface = None
        gw = get(s, "NET_GATEWAY")
        if gw:
            try:
                g = ipaddress.ip_address(gw)
                if iface and g not in iface.network:
                    errors.append(("NET_GATEWAY", tr("adm_err_gateway_net", gateway=gw, network=iface.network)))
            except ValueError:
                errors.append(("NET_GATEWAY", tr("adm_err_gateway")))
        for d in get(s, "NET_DNS").replace(",", " ").split():
            try:
                ipaddress.ip_address(d)
            except ValueError:
                errors.append(("NET_DNS", tr("adm_err_dns", value=d)))
    sip = get(s, "SERVER_IP")
    if sip != "auto":
        try:
            ipaddress.IPv4Address(sip)
        except ValueError:
            errors.append(("SERVER_IP", tr("adm_err_server_ip")))
    port = get(s, "HTTP_PORT")
    if not port.isdigit() or not 1 <= int(port) <= 65535 or int(port) == 69:
        errors.append(("HTTP_PORT", tr("adm_err_http_port")))
    if not re.fullmatch(r"[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?", get(s, "HOSTNAME")):
        errors.append(("HOSTNAME", tr("adm_err_hostname")))
    wport = get(s, "WEB_ADMIN_PORT")
    if not wport.isdigit() or not 1 <= int(wport) <= 65535 or wport in (port, "69"):
        errors.append(("WEB_ADMIN_PORT", tr("adm_err_web_port")))
    for k in ("SSH_PASSWORD_LOGIN", "SMB_IMPORT_SHARE", "WEB_ADMIN"):
        if get(s, k) not in ("yes", "no"):
            errors.append((k, tr("adm_err_yes_no", key=k)))
    if get(s, "ENI_LANGUAGE") not in dict(LANGUAGES):
        errors.append(("ENI_LANGUAGE", tr("adm_err_language", values=" ".join(dict(LANGUAGES)))))
    if not set(get(s, "EVE_ARCHES").split()) <= {"amd64", "arm64"} or not get(s, "EVE_ARCHES").split():
        errors.append(("EVE_ARCHES", tr("adm_err_arches")))
    if not set(get(s, "EVE_FLAVOURS").split()) <= {"kvm", "k"} or not get(s, "EVE_FLAVOURS").split():
        errors.append(("EVE_FLAVOURS", tr("adm_err_flavours")))
    if not get(s, "EVE_LTS_LINES").isdigit() or not 1 <= int(get(s, "EVE_LTS_LINES")) <= 10:
        errors.append(("EVE_LTS_LINES", tr("adm_err_lts_lines")))
    timeout = s.get("ENI_MENU_TIMEOUT", "")
    if timeout and not timeout.isdigit():
        errors.append(("ENI_MENU_TIMEOUT", tr("adm_err_timeout")))
    if os.path.isdir("/usr/share/zoneinfo") and not os.path.isfile(os.path.join("/usr/share/zoneinfo", get(s, "TZ"))):
        errors.append(("TZ", tr("adm_err_tz")))
    errors += dhcp_problems(s)
    serial = s.get("EVE_DEFAULT_SERIAL", "")
    if serial and serial not in SERIALS:
        errors.append(("EVE_DEFAULT_SERIAL", tr("adm_err_serial", values=" ".join(SERIALS))))
    for k, v in s.items():
        if k not in VM_KEYS and "'" in v:
            errors.append((k, tr("adm_err_quote", key=k)))
        if "\n" in v:
            errors.append((k, tr("adm_err_one_line", key=k)))
    return errors


def dhcp_problems(s):
    """[(setting, problem)] of the DHCP service settings."""
    errors = []
    mode = get(s, "DHCP_MODE")
    if mode not in DHCP_MODES:
        return [("DHCP_MODE", tr("adm_err_dhcp_mode"))]
    if mode == "off":
        return []
    if not re.fullmatch(r"(\d+[smhdw]?|infinite)", get(s, "DHCP_LEASE_TIME")):
        errors.append(("DHCP_LEASE_TIME", tr("adm_err_dhcp_lease")))
    gw = get(s, "DHCP_GATEWAY")
    if gw and gw != "none" and not is_ipv4(gw):
        errors.append(("DHCP_GATEWAY", tr("adm_err_dhcp_gateway")))
    for d in get(s, "DHCP_DNS").replace(",", " ").split():
        if d != "none" and not is_ipv4(d):
            errors.append(("DHCP_DNS", tr("adm_err_dns", value=d)))
    if mode != "server":
        return errors
    # a DHCP server hands out addresses of its own network: it needs a fixed one
    if get(s, "NET_MODE") != "static":
        errors.append(("DHCP_MODE", tr("adm_err_dhcp_static")))
        return errors
    iface, own = get(s, "NET_INTERFACE"), get(s, "DHCP_INTERFACE")
    if own and iface and own != iface:
        errors.append(("DHCP_INTERFACE", tr("adm_err_dhcp_interface", interface=iface)))
    try:
        net = ipaddress.ip_interface(get(s, "NET_ADDRESS"))
    except ValueError:
        return errors       # reported for NET_ADDRESS
    start, end = dhcp_range(s, net)
    if not start:
        errors.append(("DHCP_RANGE_START", tr("adm_err_dhcp_no_range")))
        return errors
    for key, value in (("DHCP_RANGE_START", start), ("DHCP_RANGE_END", end)):
        if not is_ipv4(value) or ipaddress.ip_address(value) not in net.network:
            errors.append((key, tr("adm_err_dhcp_range", network=net.network)))
    if any(k == "DHCP_RANGE_START" or k == "DHCP_RANGE_END" for k, _ in errors):
        return errors
    lo, hi = ipaddress.ip_address(start), ipaddress.ip_address(end)
    if lo > hi:
        errors.append(("DHCP_RANGE_END", tr("adm_err_dhcp_order")))
    elif lo <= net.ip <= hi:
        errors.append(("DHCP_RANGE_START", tr("adm_err_dhcp_own", address=net.ip)))
    return errors


def is_ipv4(value):
    try:
        ipaddress.IPv4Address(value)
        return True
    except ValueError:
        return False


def auto_range(net, exclude=()):
    """A block of addresses for DHCP in the network of ip_interface net, clear of
    the addresses in exclude (the VM, the gateway): the upper half of the
    network, else its second quarter; at most 200 addresses. (None, None) when
    the network is too small or nothing fits."""
    network = net.network
    if network.num_addresses < 8:
        return None, None
    base, size = int(network.network_address), network.num_addresses
    taken = {int(ipaddress.ip_address(x)) for x in exclude if x and is_ipv4(x)}
    for lo, hi in ((base + size // 2, base + size - 2), (base + size // 4, base + size // 2 - 1)):
        hi = min(hi, lo + 199)
        if not any(lo <= t <= hi for t in taken):
            return str(ipaddress.ip_address(lo)), str(ipaddress.ip_address(hi))
    return None, None


def dhcp_range(s, net, gateway=None):
    """(start, end): the settings, or the automatic range of net."""
    gw = gateway if gateway is not None else get(s, "NET_GATEWAY")
    start, end = auto_range(net, (str(net.ip), gw))
    return get(s, "DHCP_RANGE_START") or start, get(s, "DHCP_RANGE_END") or end


def dhcp_plan(s, addresses, primary, gateway, dns):
    """What the DHCP service uses: the settings, and for empty ones the VM's own
    network. addresses = [(interface, 'a.b.c.d/nn')], primary = the VM's main
    interface, gateway and dns = what the VM itself uses. None without an address."""
    static = get(s, "NET_MODE") == "static"
    iface = get(s, "DHCP_INTERFACE") or (get(s, "NET_INTERFACE") if static else "") or primary
    if not iface and addresses:
        iface = addresses[0][0]
    if static and get(s, "DHCP_MODE") == "server":
        net = ipaddress.ip_interface(get(s, "NET_ADDRESS"))
        own_gateway = get(s, "NET_GATEWAY")
        own_dns = get(s, "NET_DNS").replace(",", " ").split()
    else:
        found = dict(addresses).get(iface)
        if not found:
            return None
        net = ipaddress.ip_interface(found)
        own_gateway = get(s, "NET_GATEWAY") if static else gateway
        own_dns = get(s, "NET_DNS").replace(",", " ").split() if static else dns
    gw = get(s, "DHCP_GATEWAY") or own_gateway or ""
    dns_list = get(s, "DHCP_DNS").replace(",", " ").split() or own_dns or []
    start, end = dhcp_range(s, net, own_gateway or "")
    return {"interface": iface, "address": str(net.ip), "network": net.network, "start": start or "",
            "end": end or "", "gateway": "" if gw == "none" else gw,
            "dns": [d for d in dns_list if d != "none"], "lease": get(s, "DHCP_LEASE_TIME")}


def render_dnsmasq(s, plan, server_ip):
    """dnsmasq.conf of the DHCP service: only DHCP (no DNS); boot files per CPU."""
    mode = get(s, "DHCP_MODE")
    net = plan["network"]
    L = ["# managed by eve-netboot - change with: eve-netboot menu (DHCP service)",
         "port=0", f"interface={plan['interface']}", f"dhcp-leasefile={DHCP_LEASES}", "log-dhcp",
         # UEFI clients by architecture (RFC 4578): 7 and 9 x86_64, 11 arm64
         "dhcp-match=set:efi-x86_64,option:client-arch,7",
         "dhcp-match=set:efi-x86_64,option:client-arch,9",
         "dhcp-match=set:efi-arm64,option:client-arch,11"]
    if mode == "proxy":
        # next to the LAN's own DHCP server: only the network boot answers
        L += [f"dhcp-range={net.network_address},proxy,{net.netmask}",
              f'pxe-service=BC_EFI,"{PRODUCT}",eve-x86_64.efi,{server_ip}',
              f'pxe-service=X86-64_EFI,"{PRODUCT}",eve-x86_64.efi,{server_ip}',
              f'pxe-service=ARM64_EFI,"{PRODUCT}",eve-arm64.efi,{server_ip}']
    else:
        L += [f"dhcp-range={plan['start']},{plan['end']},{net.netmask},{plan['lease']}",
              "dhcp-authoritative",
              # an empty option: no router / DNS server, instead of this VM itself
              "dhcp-option=option:router" + (f",{plan['gateway']}" if plan["gateway"] else ""),
              "dhcp-option=option:dns-server" + ("," + ",".join(plan["dns"]) if plan["dns"] else ""),
              f"dhcp-boot=tag:efi-x86_64,eve-x86_64.efi,,{server_ip}",
              f"dhcp-boot=tag:efi-arm64,eve-arm64.efi,,{server_ip}"]
    return "\n".join(L) + "\n"


def validate(s, keys=None):
    """Human-readable problems (empty = fine), optionally only those of some settings."""
    return [text for key, text in problems(s) if keys is None or key in keys]


def render_settings(s):
    """settings dict -> settings.env text (consumed secrets are never written)."""
    lines = [f"# {PRODUCT} appliance settings",
             "# Change them with: eve-netboot menu   (or edit and run: eve-netboot apply)",
             "# All application settings: https://github.com/" + REPO + "/blob/main/.env.example",
             ""]
    for k in sorted(s):
        if k not in CONSUMED:
            lines.append(f"{k}={s[k]}")
    return "\n".join(lines) + "\n"


def render_export(s):
    lines = [f"# {PRODUCT} settings export, " + datetime.date.today().isoformat(),
             "# Use it as the cloud-init user-data of a new VM, or import it in the setup menu.",
             "# Passwords and tokens are not included."]
    for k in sorted(s):
        if k not in NOT_EXPORTED:
            lines.append(f"{k}={s[k]}")
    return "\n".join(lines) + "\n"


def render_stack_env(s, server_ip, image):
    """The stack's .env: application settings plus the appliance's fixed values."""
    app = {k: v for k, v in s.items() if k not in VM_KEYS and k not in FIXED and v != ""}
    for k in ("HTTP_PORT", "TZ", "ENI_LANGUAGE", "EVE_ARCHES", "EVE_FLAVOURS", "EVE_LTS_LINES",
              "ENI_IMPORT_LABEL"):
        app.setdefault(k, DEFAULTS[k])
    app.update({"SERVER_IP": server_ip, "DATA_DIR": DATA, "IMPORT_DIR": IMPORT, "ENI_IMAGE": image,
                "ENI_ADMIN_URL": admin_url(s, server_ip), "ENI_DHCP_MODE": get(s, "DHCP_MODE")})
    lines = ["# generated by eve-netboot from " + SETTINGS + " - do not edit"]
    lines += [f"{k}='{app[k]}'" for k in sorted(app)]
    return "\n".join(lines) + "\n"


def admin_url(s, server_ip):
    """Address of the web management, '' when it is switched off."""
    if get(s, "WEB_ADMIN") != "yes":
        return ""
    return f"https://{server_ip}:{get(s, 'WEB_ADMIN_PORT')}/"


def render_networkd(s):
    """(static file content or None, dhcp file content)."""
    dhcp = ("# managed by eve-netboot - change with: eve-netboot menu\n"
            "[Match]\nName=en* eth*\n\n[Network]\nDHCP=yes\n\n"
            "[DHCPv4]\n# the MAC address identifies the VM, so DHCP reservations by MAC work\n"
            "ClientIdentifier=mac\n")
    if get(s, "NET_MODE") != "static":
        return None, dhcp
    lines = ["# managed by eve-netboot - change with: eve-netboot menu", "[Match]",
             f"Name={get(s, 'NET_INTERFACE') or 'en* eth*'}", "", "[Network]",
             f"Address={get(s, 'NET_ADDRESS')}"]
    if get(s, "NET_GATEWAY"):
        lines.append(f"Gateway={get(s, 'NET_GATEWAY')}")
    for d in get(s, "NET_DNS").replace(",", " ").split():
        lines.append(f"DNS={d}")
    return "\n".join(lines) + "\n", dhcp


def render_smb_conf():
    return f"""# managed by eve-netboot - change with: eve-netboot menu
[global]
   workgroup = WORKGROUP
   server role = standalone server
   map to guest = never
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000

[eve-import]
   comment = EVE-OS installer ISOs for the EVE Netboot Installer
   path = {IMPORT}
   valid users = {ADMIN}
   read only = no
   create mask = 0644
   directory mask = 0755
"""


def is_eve_iso(path):
    """EVE installer ISOs carry the ISO9660 volume id 'EVEISO' (as in eve_sync.py)."""
    try:
        with open(path, "rb") as f:
            f.seek(0x8000)
            pvd = f.read(72)
        return pvd[1:6] == b"CD001" and pvd[40:72].strip() == b"EVEISO"
    except OSError:
        return False


def userdata_digest(text):
    return hashlib.sha256(text.encode()).hexdigest()


# --------------------------------------------------------------------------
# system helpers
# --------------------------------------------------------------------------
def log(msg):
    line = f"[{datetime.datetime.now():%Y-%m-%d %H:%M:%S}] {msg}"
    print(line, flush=True)
    try:
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def run(cmd, check=True, quiet=False, **kw):
    p = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if not quiet and (p.stdout.strip() or p.stderr.strip()):
        with open(LOG, "a") as f:
            f.write(f"$ {' '.join(cmd)}\n{p.stdout}{p.stderr}")
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} failed: {(p.stderr or p.stdout).strip()[-300:]}")
    return p


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (FileNotFoundError, PermissionError):
        return default


def write(path, content, mode=0o644):
    """Write atomically; returns True when the content changed."""
    if read(path, None) == content:
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    return True


def load_settings():
    return parse_env(read(SETTINGS))


def save_settings(s):
    write(SETTINGS, render_settings(s), 0o600)


def is_configured():
    return os.path.exists(CONFIGURED)


def version():
    return read(os.path.join(LIB, "VERSION"), "dev").strip()


def current_image(s):
    return get(s, "ENI_IMAGE") or read(os.path.join(STATE, "image")).strip() or f"{IMAGE_REPO}:{version()}"


def ipv4_addresses():
    """[(interface, 'a.b.c.d/nn')] of the VM's own network interfaces."""
    p = run(["ip", "-4", "-o", "addr", "show", "scope", "global"], check=False, quiet=True)
    out = []
    for line in p.stdout.splitlines():
        parts = line.split()
        if len(parts) > 3 and re.match(r"^(en|eth)", parts[1]):
            out.append((parts[1], parts[3]))
    return out


def primary_ip():
    p = run(["ip", "-4", "route", "get", "1.1.1.1"], check=False, quiet=True)
    m = re.search(r"\bsrc (\S+)", p.stdout)
    if m:
        return m.group(1)
    addrs = ipv4_addresses()   # a PXE LAN without a default gateway
    return addrs[0][1].split("/")[0] if addrs else ""


def primary_interface():
    p = run(["ip", "-4", "route", "get", "1.1.1.1"], check=False, quiet=True)
    m = re.search(r"\bdev (\S+)", p.stdout)
    if m:
        return m.group(1)
    addrs = ipv4_addresses()
    return addrs[0][0] if addrs else ""


def dhcp_log(lines):
    """The DHCP service's log and its current leases."""
    leases = read(DHCP_LEASES).strip()
    p = run(["journalctl", "--no-pager", "-n", str(lines), "-u", DHCP_UNIT], check=False, quiet=True)
    return (f"# {DHCP_LEASES}\n{leases or '-'}\n\n" if leases else "") + p.stdout


def default_gateway():
    p = run(["ip", "-4", "route", "show", "default"], check=False, quiet=True)
    m = re.search(r"\bvia (\S+)", p.stdout)
    return m.group(1) if m else ""


def system_dns():
    """The DNS servers the VM itself uses (not systemd-resolved's local stub)."""
    text = read("/run/systemd/resolve/resolv.conf") or read("/etc/resolv.conf")
    return [m for m in re.findall(r"(?m)^nameserver\s+(\S+)", text) if is_ipv4(m) and not m.startswith("127.")]


def dhcp_defaults(s):
    """The values the DHCP service uses now for its settings (shown for empty ones)."""
    try:
        plan = dhcp_plan(s, ipv4_addresses(), primary_interface(), default_gateway(), system_dns())
    except ValueError:
        plan = None
    if not plan:
        return {}
    return {"DHCP_INTERFACE": plan["interface"], "DHCP_RANGE_START": plan["start"], "DHCP_RANGE_END": plan["end"],
            "DHCP_GATEWAY": plan["gateway"] or "none", "DHCP_DNS": " ".join(plan["dns"]) or "none",
            "DHCP_NETWORK": str(plan["network"])}


def wait_for_ip(seconds=60):
    end = time.time() + seconds
    while time.time() < end:
        ip = primary_ip()
        if ip:
            return ip
        time.sleep(2)
    return ""


def check_password(user, password):
    """Check a password against /etc/shadow with the system's crypt() (yescrypt etc.)."""
    entry = next((line.split(":") for line in read("/etc/shadow").splitlines()
                  if line.startswith(user + ":")), None)
    if not entry or len(entry) < 2 or not entry[1] or entry[1][0] in "!*":
        return False
    try:
        libcrypt = ctypes.CDLL("libcrypt.so.1")
    except OSError:
        return False
    libcrypt.crypt.restype = ctypes.c_char_p
    libcrypt.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    out = libcrypt.crypt(password.encode(), entry[1].encode())
    return out is not None and hmac.compare_digest(out.decode(), entry[1])


def admin_has_password():
    p = run(["passwd", "-S", ADMIN], check=False, quiet=True)
    return len(p.stdout.split()) > 1 and p.stdout.split()[1] == "P"


def compose(*args, check=True, quiet=False):
    return run(["docker", "compose", "--project-directory", STACK, "-f", os.path.join(STACK, "compose.yaml"),
                "--env-file", os.path.join(STACK, ".env"), "-p", "eve-netboot", *args], check=check, quiet=quiet)


def stack_state():
    """{service: state} of the compose stack."""
    p = compose("ps", "-a", "--format", "json", check=False, quiet=True)
    states = {}
    for line in p.stdout.splitlines():
        try:
            items = json.loads(line)
        except ValueError:
            continue
        for c in items if isinstance(items, list) else [items]:
            states[c.get("Service", "?")] = c.get("State", "?")
    return states


def http_ok(port, path="/", timeout=5):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=timeout) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def healthy(s, seconds=90):
    """All three services running and the status page answering."""
    end = time.time() + seconds
    while time.time() < end:
        st = stack_state()
        if all(st.get(x) == "running" for x in ("sync", "tftp", "web")) and http_ok(get(s, "HTTP_PORT")):
            return True
        time.sleep(3)
    return False


class Lock:
    def __enter__(self):
        self.f = open(LOCK, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


# --------------------------------------------------------------------------
# apply
# --------------------------------------------------------------------------
def apply_network(s):
    if get(s, "NET_MODE") == "static" and not get(s, "NET_INTERFACE"):
        # a fixed address belongs on one adapter: the first one; others keep DHCP
        links = sorted(n for n in os.listdir("/sys/class/net") if re.match(r"^(en|eth)", n))
        if links:
            s = {**s, "NET_INTERFACE": links[0]}
    static, dhcp = render_networkd(s)
    changed = write(NET_DHCP, dhcp)
    if static:
        changed |= write(NET_STATIC, static)
    elif os.path.exists(NET_STATIC):
        os.remove(NET_STATIC)
        changed = True
    if changed:
        log("network configuration changed, reconfiguring")
        run(["networkctl", "reload"], check=False)
        links = [n for n in os.listdir("/sys/class/net") if re.match(r"^(en|eth)", n)]
        if links:
            run(["networkctl", "reconfigure", *links], check=False)
        time.sleep(3)


def apply_identity(s):
    host = get(s, "HOSTNAME")
    if read("/etc/hostname").strip() != host:
        run(["hostnamectl", "set-hostname", host], check=False)
    hosts = read("/etc/hosts")
    line = f"127.0.1.1\t{host}"
    if line not in hosts:
        hosts = re.sub(r"(?m)^127\.0\.1\.1\s.*\n?", "", hosts)
        write("/etc/hosts", hosts.rstrip("\n") + "\n" + line + "\n")
    tz = get(s, "TZ")
    if os.path.exists(os.path.join("/usr/share/zoneinfo", tz)):
        run(["timedatectl", "set-timezone", tz], check=False)


def apply_access(s):
    if s.get("ADMIN_PASSWORD"):
        run(["chpasswd"], input=f"{ADMIN}:{s['ADMIN_PASSWORD']}\n")
        log("admin password set")
    elif s.get("ADMIN_PASSWORD_HASH"):
        run(["usermod", "-p", s["ADMIN_PASSWORD_HASH"], ADMIN])
        log("admin password set (hash)")
    keys = [k.strip() for k in get(s, "ADMIN_SSH_KEYS").split(";") if k.strip()]
    write(os.path.join(KEYS_DIR, ADMIN), "".join(k + "\n" for k in keys))
    conf = ("# managed by eve-netboot\n"
            f"PasswordAuthentication {get(s, 'SSH_PASSWORD_LOGIN')}\n"
            f"AuthorizedKeysFile .ssh/authorized_keys {KEYS_DIR}/%u\n")
    if write(SSHD_CONF, conf):
        run(["systemctl", "reload-or-restart", "ssh"], check=False)


def apply_smb(s):
    if get(s, "SMB_IMPORT_SHARE") == "yes":
        write(SMB_CONF, render_smb_conf())
        if s.get("SMB_PASSWORD"):
            run(["smbpasswd", "-s", "-a", ADMIN], input=f"{s['SMB_PASSWORD']}\n{s['SMB_PASSWORD']}\n")
            log("SMB password set")
        run(["systemctl", "enable", "--now", "smbd"], check=False)
        run(["systemctl", "restart", "smbd"], check=False)
    else:
        run(["systemctl", "disable", "--now", "smbd"], check=False, quiet=True)


def server_address(s, wait=True):
    if get(s, "SERVER_IP") != "auto":
        return get(s, "SERVER_IP")
    return wait_for_ip() if wait else primary_ip()


def apply_stack(s, wait=True):
    server_ip = server_address(s, wait)
    if not server_ip:
        raise RuntimeError(tr("adm_err_no_ip"))
    for d in (os.path.join(DATA, "www"), os.path.join(DATA, "tftp"), IMPORT):
        os.makedirs(d, exist_ok=True)
    shutil.chown(IMPORT, ADMIN, ADMIN)
    write(os.path.join(STACK, ".env"), render_stack_env(s, server_ip, current_image(s)), 0o600)
    compose("up", "-d", "--no-build", "--pull", "missing", "--remove-orphans")
    log(f"stack started (SERVER_IP={server_ip})")


def apply(s, stack=True):
    """Apply settings dict s to the system; consumed secrets are applied and dropped."""
    errors = validate(s)
    if errors:
        raise ValueError("; ".join(errors))
    with Lock():
        apply_identity(s)
        apply_network(s)
        apply_access(s)
        apply_smb(s)
        clean = {k: v for k, v in s.items() if k not in CONSUMED}
        save_settings(clean)
        write(CONFIGURED, datetime.datetime.now().isoformat() + "\n")
        if stack:
            apply_stack(clean)
        apply_dhcp(clean)
        apply_web(clean)
    return clean


def apply_dhcp(s):
    """Start, change or stop the DHCP service (dnsmasq, eve-netboot-dhcp.service)."""
    if get(s, "DHCP_MODE") == "off":
        if os.path.exists(DNSMASQ_CONF):
            os.remove(DNSMASQ_CONF)
            log("DHCP service switched off")
        run(["systemctl", "disable", "--now", "--quiet", DHCP_UNIT], check=False, quiet=True)
        return
    plan = dhcp_plan(s, ipv4_addresses(), primary_interface(), default_gateway(), system_dns())
    server_ip = server_address(s, wait=False)
    if not plan or not server_ip:
        log("DHCP service not started: no IPv4 address yet")
        return
    changed = write(DNSMASQ_CONF, render_dnsmasq(s, plan, server_ip))
    run(["systemctl", "enable", "--quiet", DHCP_UNIT], check=False, quiet=True)
    run(["systemctl", "restart" if changed else "start", DHCP_UNIT], check=False, quiet=True)
    if changed:
        log(f"DHCP service: {get(s, 'DHCP_MODE')} on {plan['interface']} ({plan['network']})")


def apply_web(s):
    """Start or stop the HTTPS management. --no-block: the web UI itself may be
    the caller and must be able to answer before it is stopped/restarted."""
    unit = "eve-netboot-web.service"
    if get(s, "WEB_ADMIN") == "yes":
        run(["systemctl", "enable", "--quiet", unit], check=False, quiet=True)
        run(["systemctl", "--no-block", "restart" if web_port_changed(s) else "start", unit], check=False, quiet=True)
    else:
        run(["systemctl", "disable", "--quiet", unit], check=False, quiet=True)
        run(["systemctl", "--no-block", "stop", unit], check=False, quiet=True)


def web_port_changed(s):
    stamp = os.path.join(STATE, "web-port")
    port = get(s, "WEB_ADMIN_PORT")
    old = read(stamp).strip()
    if old != port:
        try:
            write(stamp, port + "\n")
        except OSError:
            pass
        return bool(old)
    return False


def grow_disk():
    """Use all of the disk the hypervisor gives us (cheap no-op when already done)."""
    source = run(["findmnt", "-n", "-o", "SOURCE", "/"], check=False, quiet=True).stdout.strip()
    name = os.path.basename(source)
    disk = run(["lsblk", "-n", "-o", "PKNAME", source], check=False, quiet=True).stdout.strip()
    part = read(f"/sys/class/block/{name}/partition").strip()
    if not disk or not part:
        return
    g = run(["growpart", f"/dev/{disk}", part], check=False, quiet=True)
    if g.returncode == 0:
        run(["resize2fs", source], check=False)
        log(f"root file system grown to the full disk (/dev/{disk})")


def cloud_init_settings():
    """Settings from cloud-init user-data when it changed since last time, else None."""
    text = read(USERDATA, "")
    if not text.strip():
        return None
    digest = userdata_digest(text)
    stamp = os.path.join(STATE, "userdata.sha256")
    if read(stamp).strip() == digest:
        return None
    found = parse_user_data(text)
    write(stamp, digest + "\n", 0o600)
    return found


# --------------------------------------------------------------------------
# commands without UI
# --------------------------------------------------------------------------
def cmd_boot():
    try:
        boot()
    finally:
        write(BOOT_DONE, datetime.datetime.now().isoformat() + "\n")


def boot():
    os.makedirs(STATE, exist_ok=True)
    grow_disk()
    if not any(f.startswith("ssh_host_") for f in os.listdir("/etc/ssh")):
        run(["ssh-keygen", "-A"], check=False)
    s = load_settings()
    incoming = cloud_init_settings()
    if incoming:
        log("settings from cloud-init user-data: " + ", ".join(sorted(incoming)))
        s = merge(s, incoming)
        try:
            apply(s)
            return
        except Exception as e:  # noqa: BLE001
            log(f"cloud-init settings not applied: {e}")
            write(os.path.join(STATE, "last-error"), str(e) + "\n")
            return
    if is_configured():
        try:
            apply(s)
        except Exception as e:  # noqa: BLE001
            log(f"apply failed: {e}")
            write(os.path.join(STATE, "last-error"), str(e) + "\n")
    else:
        apply_network(s)
        log("not set up yet - waiting for the setup on the console")


def status_info():
    """The appliance's state for the status screen, the menu and diagnostics."""
    s = load_settings()
    ip = primary_ip()
    env = parse_env(read(os.path.join(STACK, ".env")))
    sip = env.get("SERVER_IP") or ip or "?"
    info = {
        "version": version(), "hostname": read("/etc/hostname").strip(), "configured": is_configured(),
        "ip": ip, "server_ip": sip, "net_mode": "static" if get(s, "NET_MODE") == "static" else "dhcp",
        "status_url": f"http://{sip}:{get(s, 'HTTP_PORT')}/",
        "web_admin": admin_url(s, sip) if get(s, "WEB_ADMIN") == "yes" else "",
        "smb_share": f"\\\\{ip}\\eve-import" if get(s, "SMB_IMPORT_SHARE") == "yes" else "",
        "reboot_required": os.path.exists("/run/reboot-required"),
        "last_error": read(os.path.join(STATE, "last-error")).strip()[:200],
        "dhcp": {"mode": get(s, "DHCP_MODE")},
    }
    if info["configured"] and info["dhcp"]["mode"] != "off":
        d = dhcp_defaults(s)
        active = run(["systemctl", "is-active", DHCP_UNIT], check=False, quiet=True).stdout.strip() == "active"
        info["dhcp"].update(interface=d.get("DHCP_INTERFACE", "?"), start=d.get("DHCP_RANGE_START", ""),
                            end=d.get("DHCP_RANGE_END", ""), active=active,
                            leases=len([x for x in read(DHCP_LEASES).splitlines() if x.strip()]))
    if info["configured"]:
        info["services"] = stack_state()
        status = json.loads(read(os.path.join(WWW, "eve", "status.json"), "{}") or "{}")
        info["entries"] = status.get("entries", [])
        info["ready"] = sum(1 for e in info["entries"] if e.get("netboot_ok") and not e.get("error"))
        info["github_checked"] = status.get("github_checked") or ""
        info["activity"] = json.loads(read(os.path.join(WWW, "eve", "activity.json"), "{}") or "{}")
        du = shutil.disk_usage("/")
        info["disk_used"], info["disk_free"] = (du.total - du.free) / 2**30, du.free / 2**30
    return info


def status_rows(info):
    """[(label, value, tone)] of the main status; tone: ok, warn, err or ''."""
    net = f"{info['ip'] or tr('adm_none_yet')} ({tr('adm_net_' + info['net_mode'])})"
    if not info["configured"]:
        return [(tr("adm_st_state"), tr("adm_st_not_set_up"), "warn"), (tr("adm_st_vm_address"), net, "")]
    rows = [(tr("adm_st_vm_address"), net, ""),
            (tr("adm_st_status_page"), info["status_url"], ""),
            (tr("adm_st_web_admin"), info["web_admin"] or tr("adm_st_web_admin_off"), "" if info["web_admin"] else "warn")]
    if info["smb_share"]:
        rows.append((tr("adm_st_smb_share"), f"{info['smb_share']}  ({tr('adm_user')} {ADMIN})", ""))
    rows.append(dhcp_row(info.get("dhcp") or {"mode": "off"}))
    return rows


def dhcp_row(d):
    """(label, value, tone) of the DHCP service for the status screen."""
    label = tr("adm_st_dhcp_service")
    if d["mode"] == "off":
        return label, tr("adm_st_dhcp_off"), ""
    if not d.get("active"):
        return label, tr("adm_st_dhcp_down", mode=d["mode"]), "err"
    if d["mode"] == "proxy":
        return label, tr("adm_st_dhcp_proxy", interface=d.get("interface", "?")), "ok"
    return label, tr("adm_st_dhcp_server", start=d.get("start", ""), end=d.get("end", ""),
                     n=d.get("leases", 0)), "ok"


def status_lines():
    """The status as plain text (eve-netboot status, diagnostics)."""
    info = status_info()
    L = [f"{PRODUCT} {info['version']}   ({info['hostname']})", ""]
    L += [f"{label:<18} {value}" for label, value, _ in status_rows(info)]
    if info["configured"]:
        services = "  ".join(f"{x} {info['services'].get(x, 'missing')}" for x in ("sync", "tftp", "web"))
        L += [f"{tr('adm_st_dhcp'):<18} next-server {info['server_ip']}",
              f"{'':<18} {tr('adm_st_boot_file')} eve-x86_64.efi (x86_64 UEFI)",
              f"{'':<18} {tr('adm_st_boot_file')} eve-arm64.efi (arm64 UEFI)",
              f"{tr('adm_st_services'):<18} {services}",
              f"{tr('adm_st_installers'):<18} " + tr("adm_st_installers_value", n=info["ready"],
                                                      date=info["github_checked"] or "-"),
              f"{tr('adm_st_disk'):<18} " + tr("adm_st_disk_value", used=f"{info['disk_used']:.1f}",
                                                free=f"{info['disk_free']:.1f}")]
    if info["reboot_required"]:
        L.append(f"{tr('adm_st_updates'):<18} {tr('adm_st_reboot_needed')}")
    if info["last_error"]:
        L += ["", tr("adm_st_last_error") + ": " + info["last_error"]]
    return L


def cmd_status():
    print("\n".join(status_lines()))


def cmd_export():
    print(render_export(load_settings()), end="")


def update_system(say=print):
    """apt update/upgrade/autoremove; never touches packages marked manual."""
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    opts = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]
    say(tr("adm_upd_lists"))
    run(["apt-get", "update"], env=env)
    say(tr("adm_upd_installing"))
    run(["apt-get", "-y", *opts, "full-upgrade"], env=env)
    say(tr("adm_upd_autoremove"))
    run(["apt-get", "-y", "autoremove", "--purge"], env=env)
    run(["apt-get", "clean"], env=env)
    s = load_settings()
    if is_configured():
        apply_stack(s)
        ok = healthy(s)
    else:
        ok = True
    reboot = os.path.exists("/run/reboot-required")
    msg = tr("adm_upd_done") + " " + tr("adm_upd_working" if ok else "adm_upd_unhealthy")
    if reboot:
        msg += " " + tr("adm_upd_reboot")
    log(msg)
    return ok, reboot, msg


def version_tuple(ref):
    """'ghcr.io/x/y:1.2.3' or 'v1.2.3' -> (1, 2, 3); None for latest/dev builds."""
    m = re.search(r"(?:^|[:v])(\d+)\.(\d+)\.(\d+)$", ref)
    return tuple(int(x) for x in m.groups()) if m else None


def latest_release():
    req = urllib.request.Request(f"https://api.github.com/repos/{REPO}/releases/latest",
                                 headers={"Accept": "application/vnd.github+json",
                                          "User-Agent": "eve-netboot-appliance"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)["tag_name"]


def update_app(say=print):
    """Newest release: pull image + compose.yaml, check health, roll back on failure."""
    s = load_settings()
    if s.get("ENI_IMAGE"):
        return False, tr("adm_app_pinned", image=s["ENI_IMAGE"])
    tag = latest_release()
    target = f"{IMAGE_REPO}:{tag.lstrip('v')}"
    old_image = current_image(s)
    current, newest = version_tuple(old_image), version_tuple(tag)
    if current is None:
        return False, tr("adm_app_dev", image=old_image)
    if newest is None or newest <= current:
        return True, tr("adm_app_current", version=old_image.rsplit(":", 1)[-1])
    say(tr("adm_app_downloading", image=target))
    run(["docker", "pull", target])
    compose_url = f"https://raw.githubusercontent.com/{REPO}/{tag}/compose.yaml"
    with urllib.request.urlopen(compose_url, timeout=30) as r:
        new_compose = r.read().decode()
    old_compose = read(os.path.join(STACK, "compose.yaml"))
    write(os.path.join(STACK, "compose.yaml"), new_compose)
    write(os.path.join(STATE, "image"), target + "\n")
    say(tr("adm_app_restarting"))
    try:
        apply_stack(s)
        ok = healthy(s)
    except Exception as e:  # noqa: BLE001
        log(f"update failed: {e}")
        ok = False
    if ok:
        log(f"app updated: {old_image} -> {target}")
        return True, tr("adm_app_updated", version=tag)
    say(tr("adm_app_rolling_back"))
    write(os.path.join(STACK, "compose.yaml"), old_compose)
    write(os.path.join(STATE, "image"), old_image + "\n")
    apply_stack(s)
    log(f"app update to {target} rolled back to {old_image}")
    return False, tr("adm_app_rolled_back", version=tag, image=old_image)


def publish_export(s, minutes=15):
    """Put the export on the status web server under a random name for a while."""
    name = f"export-{secrets.token_hex(3)}.txt"
    path = os.path.join(WWW, name)
    write(path, render_export(s))
    run(["systemd-run", f"--on-active={minutes}min", "/bin/rm", "-f", path], check=False)
    env = parse_env(read(os.path.join(STACK, ".env")))
    return f"http://{env.get('SERVER_IP') or primary_ip()}:{get(s, 'HTTP_PORT')}/{name}"


def fetch_import(url):
    if not re.match(r"^https?://", url):
        url = "http://" + url
    with urllib.request.urlopen(url, timeout=15) as r:
        text = r.read(65536).decode("utf-8", "replace")
    found = parse_env(text)
    if not found:
        raise ValueError(tr("adm_imp_none"))
    return found


# --------------------------------------------------------------------------
# whiptail UI
# --------------------------------------------------------------------------
# The look of EVE-OS's own console (the EVE monitor): black, light grey text and
# lines, the selection inverted. Texts in ENI_LANGUAGE (see tr()).
NEWT_COLORS = " ".join([
    "root=lightgray,black", "roottext=lightgray,black", "border=lightgray,black", "window=lightgray,black",
    # whiptail's <OK> buttons are compact buttons: "compactbutton" when not
    # selected, "button" when selected (so that one is inverted)
    "shadow=black,black", "title=white,black", "button=black,lightgray", "actbutton=black,lightgray",
    "compactbutton=lightgray,black", "checkbox=lightgray,black", "actcheckbox=black,lightgray",
    "entry=black,lightgray", "disentry=gray,black", "label=lightgray,black", "listbox=lightgray,black",
    "actlistbox=black,lightgray", "sellistbox=lightgray,black", "actsellistbox=black,lightgray",
    "textbox=lightgray,black", "acttextbox=black,lightgray", "helpline=black,lightgray",
    "emptyscale=,black", "fullscale=,lightgray"])


# functional colour per dialog, as in the EVE monitor: red for errors and for
# questions that stop the server, orange for warnings, green for success
DIALOG_TONES = {
    "err": "border=red,black title=brightred,black button=black,red",
    "warn": "border=brown,black title=yellow,black button=black,brown",
    "ok": "border=green,black title=brightgreen,black button=black,green",
}


class Cancel(Exception):
    pass


def rows(text, width=72):
    """Screen lines whiptail needs for text in a box of the given width."""
    return sum(max(1, -(-len(line) // (width - 6))) for line in text.split("\n"))


_abort_if = None    # the setup wizard: stop asking once the VM was set up elsewhere


def wt(kind, title, text, *args, height=0, width=72, extra=(), tone=None):
    # UTF-8 for the translations; the console's own locale may be plain C
    colors = NEWT_COLORS + (" " + DIALOG_TONES[tone] if tone else "")
    env = dict(os.environ, NEWT_COLORS=colors, LC_ALL="C.UTF-8")
    cmd = ["whiptail", "--backtitle", f"{PRODUCT} {version()}", "--title", f" {title} ", *extra, kind, text,
           str(height), str(width), *args]
    p = subprocess.Popen(cmd, stderr=subprocess.PIPE, text=True, env=env)
    while True:
        try:
            _, err = p.communicate(timeout=2)
            return p.returncode, err.strip()
        except subprocess.TimeoutExpired:
            if _abort_if and _abort_if():
                # set up in the browser or through cloud-init meanwhile
                p.terminate()
                p.communicate()
                subprocess.run(["stty", "sane"], check=False)
                return 255, ""


def msg(title, text, tone=None):
    # an explicit height: with 0, whiptail also ignores the width and does not wrap
    wt("--msgbox", title, text, height=min(rows(text) + 7, 22), extra=["--ok-button", tr("adm_btn_ok")], tone=tone,
       width=72)


def info(title, text, tone="warn"):
    wt("--infobox", title, text, height=rows(text) + 4, tone=tone)


def yesno(title, text, yes=None, no=None, default_no=False, tone=None):
    extra = ["--yes-button", yes or tr("adm_btn_yes"), "--no-button", no or tr("adm_btn_no")]
    return wt("--yesno", title, text, height=min(rows(text) + 7, 22), tone=tone,
              extra=extra + (["--defaultno"] if default_no else []))[0] == 0


def ask(title, text, default="", password=False, cancel=None):
    kind = "--passwordbox" if password else "--inputbox"
    rc, out = wt(kind, title, text, *([] if password else [default]), height=rows(text) + 8,
                 extra=["--ok-button", tr("adm_btn_ok"), "--cancel-button", cancel or tr("adm_btn_back")])
    if rc != 0:
        raise Cancel
    return out.strip()


def choose(title, text, items, default=None, cancel=None, ok=None):
    """cancel=False: no cancel button."""
    args = []
    for tag, label in items:
        args += [tag, label]
    extra = (["--nocancel"] if cancel is False else ["--cancel-button", cancel or tr("adm_btn_back")])
    extra += ["--ok-button", ok or tr("adm_btn_select"), "--notags"]
    if default:
        extra += ["--default-item", default]
    rc, out = wt("--menu", title, text, str(min(len(items), 14)), *args,
                 height=min(len(items), 14) + rows(text) + 7, extra=extra)
    if rc != 0:
        raise Cancel
    return out


def checklist(title, text, items, selected):
    args = []
    for tag, label in items:
        args += [tag, label, "ON" if tag in selected else "OFF"]
    rc, out = wt("--checklist", title, text, str(len(items)), *args, height=len(items) + rows(text) + 7,
                 extra=["--ok-button", tr("adm_btn_ok"), "--cancel-button", tr("adm_btn_back"),
                        "--separate-output", "--notags"])
    if rc != 0:
        raise Cancel
    return out.split()


def ask_password(title, what="admin", minimum=8):
    while True:
        p1 = ask(title, tr("adm_pw_new_share" if what == "share" else "adm_pw_new_admin", n=minimum), password=True)
        if len(p1) < minimum:
            msg(title, tr("adm_pw_too_short", n=minimum), tone="err")
            continue
        p2 = ask(title, tr("adm_pw_again"), password=True)
        if p1 != p2:
            msg(title, tr("adm_pw_mismatch"), tone="err")
            continue
        return p1


# ---- the settings, grouped as on the web pages (ui/src/sections.ts); labels,
# help texts and option names are shared with the web UI (adm_f_*, adm_h_*, adm_o_*)
def adapters():
    return sorted(n for n in os.listdir("/sys/class/net") if re.match(r"^(en|eth)", n))


FIELDS = {
    "NET_MODE": ("choice", ["dhcp", "static"]),
    "NET_ADDRESS": ("text", None), "NET_GATEWAY": ("text", None), "NET_DNS": ("text", None),
    "NET_INTERFACE": ("adapter", None), "HOSTNAME": ("text", None),
    "SERVER_IP": ("text", None), "HTTP_PORT": ("text", None),
    "EVE_ARCHES": ("checks", ["amd64", "arm64"]), "EVE_FLAVOURS": ("checks", ["kvm", "k"]),
    "EVE_LTS_LINES": ("text", None), "ENI_SYNC_INTERVAL": ("choice", ["86400", "43200", "604800", "0"]),
    "EVE_GITHUB_REPO": ("text", None), "ENI_GITHUB_TOKEN": ("secret", None),
    "ENI_LANGUAGE": ("language", None), "ENI_MENU_MODE": ("choice", ["standalone", "chained"]),
    "ENI_MENU_TIMEOUT": ("text", None), "ENI_IMPORT_LABEL": ("text", None),
    "IPXE_ALIASES_X86_64": ("text", None), "IPXE_ALIASES_ARM64": ("text", None),
    "EVE_DEFAULT_INSTALL_SERVER": ("text", None), "EVE_DEFAULT_SERIAL": ("choice", SERIALS),
    "EVE_DEFAULT_INSTALL_DISK": ("text", None), "EVE_DEFAULT_PERSIST_DISK": ("text", None),
    "EVE_DEFAULT_REBOOT": ("onezero", None), "EVE_DEFAULT_SOFT_SERIAL": ("onezero", None),
    "EVE_DEFAULT_NUKE_ALL_DISKS": ("onezero", None), "EVE_DEFAULT_EXTRA_ARGS": ("text", None),
    "SMB_IMPORT_SHARE": ("yesno", None), "SMB_PASSWORD": ("smbpassword", None),
    "WEB_ADMIN": ("yesno", None), "WEB_ADMIN_PORT": ("text", None), "SSH_PASSWORD_LOGIN": ("yesno", None),
    "ADMIN_SSH_KEYS": ("keys", None), "TZ": ("text", None),
    "DHCP_MODE": ("choice", list(DHCP_MODES)), "DHCP_INTERFACE": ("dhcpadapter", None),
    "DHCP_RANGE_START": ("text", None), "DHCP_RANGE_END": ("text", None), "DHCP_GATEWAY": ("text", None),
    "DHCP_DNS": ("text", None), "DHCP_LEASE_TIME": ("text", None),
}
SECTIONS = {
    "network": ["NET_MODE", "NET_ADDRESS", "NET_GATEWAY", "NET_DNS", "NET_INTERFACE", "HOSTNAME"],
    "server": ["SERVER_IP", "HTTP_PORT"],
    "dhcp": ["DHCP_MODE", "DHCP_INTERFACE", "DHCP_RANGE_START", "DHCP_RANGE_END", "DHCP_GATEWAY", "DHCP_DNS",
             "DHCP_LEASE_TIME"],
    "mirror": ["EVE_ARCHES", "EVE_FLAVOURS", "EVE_LTS_LINES", "ENI_SYNC_INTERVAL", "EVE_GITHUB_REPO",
               "ENI_GITHUB_TOKEN"],
    "bootmenu": ["ENI_LANGUAGE", "ENI_MENU_MODE", "ENI_MENU_TIMEOUT", "ENI_IMPORT_LABEL",
                 "IPXE_ALIASES_X86_64", "IPXE_ALIASES_ARM64"],
    "defaults": ["EVE_DEFAULT_INSTALL_SERVER", "EVE_DEFAULT_SERIAL", "EVE_DEFAULT_INSTALL_DISK",
                 "EVE_DEFAULT_PERSIST_DISK", "EVE_DEFAULT_REBOOT", "EVE_DEFAULT_SOFT_SERIAL",
                 "EVE_DEFAULT_NUKE_ALL_DISKS", "EVE_DEFAULT_EXTRA_ARGS"],
    "share": ["SMB_IMPORT_SHARE", "SMB_PASSWORD"],
    "access": ["WEB_ADMIN", "WEB_ADMIN_PORT", "SSH_PASSWORD_LOGIN", "ADMIN_SSH_KEYS", "TZ"],
}
SHOWN_IF = {
    "NET_ADDRESS": lambda s: get(s, "NET_MODE") == "static",
    "NET_GATEWAY": lambda s: get(s, "NET_MODE") == "static",
    "NET_DNS": lambda s: get(s, "NET_MODE") == "static",
    "NET_INTERFACE": lambda s: get(s, "NET_MODE") == "static",
    "SMB_PASSWORD": lambda s: get(s, "SMB_IMPORT_SHARE") == "yes",
    "DHCP_INTERFACE": lambda s: get(s, "DHCP_MODE") != "off",
    **{k: (lambda s: get(s, "DHCP_MODE") == "server")
       for k in ("DHCP_RANGE_START", "DHCP_RANGE_END", "DHCP_GATEWAY", "DHCP_DNS", "DHCP_LEASE_TIME")},
}


def has_text(key):
    return key in texts("en")


def label(key):
    return tr("adm_f_" + key.lower())


def help_text(key, s=None):
    k = "adm_h_" + key.lower()
    if not has_text(k):
        return ""
    ip = primary_ip() or "VM"
    return tr(k, ip=ip, url=f"https://{ip}:{get(s or load_settings(), 'WEB_ADMIN_PORT')}/")


def option(key, value):
    k = f"adm_o_{key.lower()}_{value.lower()}"
    return tr(k) if has_text(k) else value


def shown_value(s, key):
    kind, opts = FIELDS[key]
    v = s.get(key) or get(s, key)
    if key.startswith("DHCP_") and key not in ("DHCP_MODE", "DHCP_LEASE_TIME") and not s.get(key):
        # empty = what the VM's own network gives
        return f"{tr('adm_auto')}: {dhcp_defaults(s).get(key) or '-'}"
    if kind == "yesno":
        return tr("adm_on") if v == "yes" else tr("adm_off")
    if kind == "onezero":
        return tr("adm_on") if v == "1" else tr("adm_off")
    if kind == "secret":
        return tr("adm_set") if s.get(key) else tr("adm_not_set")
    if kind == "smbpassword":
        return tr("adm_set") if smb_has_password() else tr("adm_not_set")
    if kind == "keys":
        return str(len([k for k in v.split(";") if k.strip()]))
    if kind == "language":
        return dict(LANGUAGES).get(v, v)
    if kind == "checks":
        return ", ".join(option(key, x) for x in v.split()) or "-"
    if kind == "choice":
        # "Proxy: only the network boot answers ..." -> "Proxy" (the full text is in the choice)
        return option(key, v).split(":")[0].strip() if v else "-"
    if not v:
        return tr("adm_p_" + key.lower()) if has_text("adm_p_" + key.lower()) else "-"
    return v


def edit_field(title, key, s):
    """Ask for one setting; changes s. Raises Cancel."""
    kind, opts = FIELDS[key]
    text = label(key) + (("\n\n" + help_text(key, s)) if help_text(key, s) else "")
    current = s.get(key) or get(s, key)
    if kind in ("yesno", "onezero"):
        on, off = ("yes", "no") if kind == "yesno" else ("1", "0")
        s[key] = on if yesno(title, text, tr("adm_on"), tr("adm_off"), default_no=current != on) else off
    elif kind == "choice":
        s[key] = choose(title, text, [(o, option(key, o)) for o in opts], default=current or None)
    elif kind == "language":
        s[key] = choose(title, text, LANGUAGES, default=current or "en")
    elif kind == "dhcpadapter":
        auto = dhcp_defaults(s).get("DHCP_INTERFACE", "-")
        s[key] = choose(title, text, [("", f"{tr('adm_auto')}: {auto}")] + [(n, n) for n in adapters()],
                        default=current or "")
    elif kind == "adapter":
        addrs = dict(ipv4_addresses())
        items = [("", tr("adm_o_net_interface_first"))] + [
            (n, f"{n} ({tr('adm_now')} {addrs[n]})" if n in addrs else n) for n in adapters()]
        s[key] = choose(title, text, items, default=current or "")
    elif kind == "checks":
        while True:
            chosen = checklist(title, text + "\n" + tr("adm_space_selects"), [(o, option(key, o)) for o in opts],
                               current.split())
            if chosen:
                break
            msg(title, tr("adm_select_one"), tone="err")
        s[key] = " ".join(chosen)
    elif kind == "secret":
        value = ask(title, text + "\n" + tr("adm_secret_empty_keeps"), password=True, cancel=tr("adm_btn_cancel"))
        if value == "-":
            s.pop(key, None)
        elif value:
            s[key] = value
    elif kind == "smbpassword":
        s[key] = ask_password(title, "share")
    elif kind == "keys":
        s[key] = ask(title, text, current, cancel=tr("adm_btn_cancel"))
    else:
        s[key] = ask(title, text, current, cancel=tr("adm_btn_cancel"))


def screen_section(section, s):
    """A list of the section's settings with their values; Enter changes one."""
    s = dict(s)
    title = tr("adm_sec_" + section)
    while True:
        keys = [k for k in SECTIONS[section] if k not in SHOWN_IF or SHOWN_IF[k](s)]
        width = min(max(len(label(k)) for k in keys), 34)
        items = [(k, f"{cut(label(k), width):<{width}}  {cut(shown_value(s, k), 60 - width)}") for k in keys]
        try:
            c = choose(title, tr("adm_sec_" + section + "_text") + "\n\n" + tr("adm_section_hint"), items,
                       cancel=tr("adm_btn_done"), ok=tr("adm_btn_change"))
        except Cancel:
            return s
        before = set(validate(s))
        old = dict(s)
        try:
            if c == "NET_MODE":
                s = screen_network(s, hostname=False)
                continue
            edit_field(title, c, s)
            if c == "DHCP_MODE" and s[c] == "server" and old.get(c) != "server" and not yesno(
                    title, tr("adm_dhcp_warning"), yes=tr("adm_btn_continue"), no=tr("adm_btn_cancel"),
                    default_no=True, tone="warn"):
                raise Cancel
        except Cancel:
            s = old
            continue
        errors = [e for e in validate(s) if e not in before]
        if errors:
            msg(title, "\n".join(errors), tone="err")
            s = old


# ---- step by step, for the setup wizard (and the network, which belongs together)
def screen_network(s, hostname=True):
    s = dict(s)
    title = tr("adm_sec_network")
    current = ", ".join(tr("adm_addr_on", address=a, interface=i) for i, a in ipv4_addresses()) or tr("adm_none_yet")
    mode = choose(title, tr("adm_net_question", now=current),
                  [("dhcp", option("NET_MODE", "dhcp")), ("static", option("NET_MODE", "static"))],
                  default=get(s, "NET_MODE"))
    s["NET_MODE"] = mode
    if mode == "dhcp":
        for k in ("NET_ADDRESS", "NET_GATEWAY", "NET_DNS", "NET_INTERFACE"):
            s.pop(k, None)
    while mode == "static":
        if len(adapters()) > 1:
            edit_field(title, "NET_INTERFACE", s)
        s["NET_ADDRESS"] = ask(title, tr("adm_net_ask_address"),
                               s.get("NET_ADDRESS") or (ipv4_addresses()[0][1] if ipv4_addresses() else ""))
        s["NET_GATEWAY"] = ask(title, tr("adm_net_ask_gateway"), s.get("NET_GATEWAY", ""))
        s["NET_DNS"] = ask(title, tr("adm_net_ask_dns"), s.get("NET_DNS", ""))
        errors = validate(s, ("NET_MODE", "NET_ADDRESS", "NET_GATEWAY", "NET_DNS"))
        if not errors:
            break
        msg(title, "\n".join(errors), tone="err")
    while hostname:
        s["HOSTNAME"] = ask(title, label("HOSTNAME") + ":", get(s, "HOSTNAME"))
        errors = validate(s, ("HOSTNAME",))
        if not errors:
            break
        msg(title, "\n".join(errors), tone="err")
    return s


def screen_server_ip(s):
    s = dict(s)
    title = tr("adm_sec_server")
    ip = primary_ip() or "?"
    c = choose(title, tr("adm_server_question"),
               [("auto", tr("adm_server_opt_auto", ip=ip)), ("manual", tr("adm_server_opt_manual"))],
               default="auto" if get(s, "SERVER_IP") == "auto" else "manual")
    if c == "auto":
        s["SERVER_IP"] = "auto"
        return s
    while True:
        s["SERVER_IP"] = ask(title, tr("adm_server_ask"), "" if get(s, "SERVER_IP") == "auto" else get(s, "SERVER_IP"))
        errors = validate(s, ("SERVER_IP",))
        if not errors:
            return s
        msg(title, "\n".join(errors), tone="err")


def screen_language(s, first=False):
    s = dict(s)
    title = "Language / Sprache / Langue / Idioma / Taal / Sprog" if first else tr("adm_sec_language")
    s["ENI_LANGUAGE"] = choose(title, tr("adm_language_text"), LANGUAGES, default=get(s, "ENI_LANGUAGE"),
                               cancel=False if first else None)
    set_language(s["ENI_LANGUAGE"])
    return s


def screen_mirror(s):
    s = dict(s)
    title = tr("adm_sec_mirror")
    for key in ("EVE_ARCHES", "EVE_FLAVOURS"):
        edit_field(title, key, s)
    while True:
        s["EVE_LTS_LINES"] = ask(title, label("EVE_LTS_LINES") + "\n\n" + help_text("EVE_LTS_LINES"),
                                 get(s, "EVE_LTS_LINES"))
        errors = validate(s, ("EVE_LTS_LINES",))
        if not errors:
            return s
        msg(title, "\n".join(errors), tone="err")


def screen_defaults(s):
    s = dict(s)
    title = tr("adm_sec_defaults")
    for key in ("EVE_DEFAULT_INSTALL_SERVER", "EVE_DEFAULT_SERIAL"):
        edit_field(title, key, s)
    return s


def screen_smb(s):
    s = dict(s)
    title = tr("adm_sec_share")
    on = yesno(title, tr("adm_share_question", share=f"\\\\{primary_ip() or 'VM'}\\eve-import", user=ADMIN),
               yes=tr("adm_share_yes"), no=tr("adm_share_no"), default_no=get(s, "SMB_IMPORT_SHARE") != "yes")
    s["SMB_IMPORT_SHARE"] = "yes" if on else "no"
    if on and (not smb_has_password() or yesno(title, tr("adm_share_new_password"), default_no=True)):
        s["SMB_PASSWORD"] = ask_password(title, "share")
    return s


def smb_has_password():
    p = run(["pdbedit", "-L"], check=False, quiet=True)
    return any(line.startswith(ADMIN + ":") for line in p.stdout.splitlines())


def summary(s):
    net = ("DHCP" if get(s, "NET_MODE") == "dhcp" else
           f"{get(s, 'NET_ADDRESS')} gw {get(s, 'NET_GATEWAY') or '-'} dns {get(s, 'NET_DNS') or '-'}")
    server = (tr("adm_this_vm", ip=primary_ip() or "?") if get(s, "SERVER_IP") == "auto" else get(s, "SERVER_IP"))
    rows_ = [(tr("adm_sec_network"), net), (tr("adm_sec_server"), server),
             (tr("adm_sec_language"), dict(LANGUAGES)[get(s, "ENI_LANGUAGE")]),
             (tr("adm_sec_mirror"), tr("adm_mirror_summary", n=get(s, "EVE_LTS_LINES"), arches=get(s, "EVE_ARCHES"),
                                       flavours=get(s, "EVE_FLAVOURS"))),
             (label("EVE_DEFAULT_INSTALL_SERVER"), shown_value(s, "EVE_DEFAULT_INSTALL_SERVER")),
             (label("EVE_DEFAULT_SERIAL"), option("EVE_DEFAULT_SERIAL", s.get("EVE_DEFAULT_SERIAL") or "none")),
             (tr("adm_sec_share"), shown_value(s, "SMB_IMPORT_SHARE"))]
    width = max(len(k) for k, _ in rows_)
    return "\n".join(f"{k:<{width}}  {v}" for k, v in rows_)


def apply_with_feedback(s, title=None):
    info(title or tr("adm_applying"), tr("adm_applying_text"))
    try:
        clean = apply(s)
    except Exception as e:  # noqa: BLE001
        log(f"apply failed: {e}")
        msg(tr("adm_error"), tr("adm_apply_failed", error=e, log=LOG), tone="err")
        return None
    finally:
        set_language(None)   # from now on: the saved language
    return clean


def settings_files():
    """Exported settings files someone put into the import folder (SMB share)."""
    try:
        names = os.listdir(IMPORT)
    except OSError:
        return []
    return sorted(n for n in names if n.lower().endswith((".txt", ".env")) and not n.startswith(".")
                  and os.path.isfile(os.path.join(IMPORT, n)))[:12]


def import_dialog(title):
    """Settings of another VM: from the address its export shows, or from an
    exported file copied into the import folder. Raises Cancel."""
    files = settings_files()
    c = "url"
    if files:
        c = choose(title, tr("adm_imp_where"), [("url", tr("adm_imp_from_url"))] +
                   [("file:" + n, tr("adm_imp_from_file", file=n)) for n in files], cancel=tr("adm_btn_cancel"))
    if c == "url":
        url = ask(title, tr("adm_imp_ask_url"), cancel=tr("adm_btn_cancel"))
        return fetch_import(url)
    found = parse_env(read(os.path.join(IMPORT, c[5:])))
    if not found:
        raise ValueError(tr("adm_imp_none"))
    return found


def wizard():
    """First-time setup on the console. Returns when the appliance is set up."""
    global _abort_if
    _abort_if = is_configured
    try:
        _wizard()
    finally:
        _abort_if = None


def _wizard():
    s = load_settings()
    steps = ["language", "welcome", "password", "network", "server", "mirror", "defaults", "smb", "confirm"]
    i = 0
    while True:
        if is_configured():
            set_language(None)
            return   # set up in the meantime (web setup or cloud-init)
        step = steps[i]
        try:
            if step == "language":
                s = screen_language(s, first=True)
            elif step == "welcome":
                c = choose(tr("adm_welcome"), tr("adm_welcome_text") + "\n" + tr("adm_keys_hint"),
                           [("new", tr("adm_setup_new")), ("import", tr("adm_setup_import")),
                            ("poweroff", tr("adm_poweroff"))], ok=tr("adm_btn_continue"))
                if c == "poweroff":
                    if yesno(tr("adm_poweroff"), tr("adm_poweroff_q"), default_no=True, tone="err"):
                        run(["systemctl", "poweroff"], check=False)
                    continue
                if c == "import":
                    try:
                        s = merge(s, import_dialog(tr("adm_import")))
                        set_language(get(s, "ENI_LANGUAGE"))
                        msg(tr("adm_import"), tr("adm_imp_done_check"), tone="ok")
                    except Cancel:
                        continue
                    except Exception as e:  # noqa: BLE001
                        msg(tr("adm_import"), tr("adm_imp_failed", error=e), tone="err")
                        continue
            elif step == "password":
                s["ADMIN_PASSWORD"] = ask_password(tr("adm_admin_password"))
            elif step == "network":
                new = screen_network(s, hostname=False)
                if render_networkd(new) != render_networkd(s) or not os.path.exists(NET_DHCP):
                    apply_network(new)  # so the next screens see the new address
                s = new
            elif step == "server":
                s = screen_server_ip(s)
            elif step == "mirror":
                s = screen_mirror(s)
            elif step == "defaults":
                s = screen_defaults(s)
            elif step == "smb":
                s = screen_smb(s)
            elif step == "confirm":
                if not yesno(tr("adm_ready"), summary(s) + "\n\n" + tr("adm_ready_q"),
                             yes=tr("adm_btn_apply"), no=tr("adm_btn_back")):
                    raise Cancel
                # set up on the console: web management stays off unless switched on
                # (menu -> Access and system)
                s.setdefault("WEB_ADMIN", "no")
                global _abort_if
                _abort_if = None    # set up here from now on: keep showing its messages
                if apply_with_feedback(s, tr("adm_setting_up")) is not None:
                    return
                continue
            i += 1
        except Cancel:
            i = max(0, i - 1)


def show_log(source):
    if source in ("sync", "tftp", "web"):
        p = compose("logs", "--no-color", "--tail", "300", source, check=False, quiet=True)
        text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", p.stdout + p.stderr)
    elif source == "appliance":
        text = "\n".join(read(LOG).splitlines()[-300:])
    elif source == "dhcp":
        text = dhcp_log(300)
    else:
        text = run(["journalctl", "--no-pager", "-n", "300", "-u", "eve-netboot-setup", "-u", "eve-netboot-web",
                    "-u", "docker"], check=False, quiet=True).stdout
    path = "/tmp/eve-netboot-logs.txt"
    write(path, text or "-\n")
    wt("--textbox", tr("adm_log_title", source=option("LOG", source)), path, height=22, width=78,
       extra=["--scrolltext", "--ok-button", tr("adm_btn_ok")])


def menu():
    """Settings menu (admin): the same pages as the web UI. Exit code 10 = open
    a shell, 0 = log out."""
    while True:
        s = load_settings()
        try:
            c = choose(tr("adm_menu"), "\n".join(status_lines()[2:5]) + "\n", [
                ("status", tr("adm_nav_status")),
                ("network", tr("adm_sec_network")),
                ("server", tr("adm_sec_server")),
                ("dhcp", tr("adm_sec_dhcp")),
                ("mirror", tr("adm_sec_mirror")),
                ("bootmenu", tr("adm_sec_bootmenu")),
                ("defaults", tr("adm_sec_defaults")),
                ("share", tr("adm_sec_share")),
                ("access", tr("adm_sec_access")),
                ("sync", tr("adm_sync_now")),
                ("logs", tr("adm_nav_logs")),
                ("export", tr("adm_export_menu")),
                ("import", tr("adm_import")),
                ("update", tr("adm_update_system")),
                ("app", tr("adm_update_app")),
                ("password", tr("adm_change_password")),
                ("shell", tr("adm_shell")),
                ("reboot", tr("adm_reboot")),
                ("poweroff", tr("adm_poweroff")),
                ("logout", tr("adm_logout")),
            ], cancel=tr("adm_logout"), ok=tr("adm_btn_open"))
        except Cancel:
            return 0
        try:
            if c == "status":
                msg(tr("adm_nav_status"), "\n".join(status_lines()))
            elif c in SECTIONS:
                new = screen_network(s) if c == "network" else screen_section(c, s)
                if new != s or "SMB_PASSWORD" in new:
                    if c == "network" and os.environ.get("SSH_CONNECTION") and not yesno(
                            tr("adm_sec_network"), tr("adm_net_ssh_warning"), default_no=True, tone="warn"):
                        continue
                    apply_with_feedback(new)
            elif c == "sync":
                compose("restart", "sync", check=False)
                msg("GitHub", tr("adm_sync_started"), tone="ok")
            elif c == "logs":
                source = choose(tr("adm_nav_logs"), tr("adm_logs_text"),
                                [(x, option("LOG", x)) for x in ("sync", "tftp", "web", "dhcp", "appliance", "system")],
                                cancel=tr("adm_btn_back"), ok=tr("adm_btn_open"))
                show_log(source)
            elif c == "export":
                url = publish_export(s)
                copies = [f"/home/{ADMIN}/eve-netboot-settings.txt", os.path.join(IMPORT, "eve-netboot-settings.txt")]
                for path in copies:
                    write(path, render_export(s))
                    shutil.chown(path, ADMIN, ADMIN)
                msg(tr("adm_export_menu"), tr("adm_export_done", url=url, home=copies[0],
                                               share=f"\\\\{primary_ip() or 'VM'}\\eve-import\\eve-netboot-settings.txt"))
            elif c == "import":
                new = merge(s, import_dialog(tr("adm_import")))
                if yesno(tr("adm_import"), summary(new) + "\n\n" + tr("adm_imp_apply_q"),
                         yes=tr("adm_btn_apply"), no=tr("adm_btn_cancel")):
                    apply_with_feedback(new)
            elif c == "update":
                if yesno(tr("adm_update_system"), tr("adm_update_system_q"),
                         yes=tr("adm_btn_update"), no=tr("adm_btn_cancel")):
                    ok, reboot, text = update_system(lambda t: info(tr("adm_updating"), t))
                    if reboot and yesno(tr("adm_update_system"), text + "\n\n" + tr("adm_reboot_now_q"),
                                        yes=tr("adm_btn_reboot"), no=tr("adm_btn_later"), tone="warn"):
                        run(["systemctl", "reboot"], check=False)
                    elif not reboot:
                        msg(tr("adm_update_system"), text, tone="ok" if ok else "err")
            elif c == "app":
                if yesno(tr("adm_update_app"), tr("adm_update_app_q", image=current_image(s)),
                         yes=tr("adm_btn_update"), no=tr("adm_btn_cancel")):
                    ok, text = update_app(lambda t: info(tr("adm_updating"), t))
                    msg(tr("adm_update_app"), text, tone="ok" if ok else "err")
            elif c == "password":
                pw = ask_password(tr("adm_admin_password"))
                run(["chpasswd"], input=f"{ADMIN}:{pw}\n")
                msg(tr("adm_admin_password"), tr("adm_password_changed"), tone="ok")
            elif c == "shell":
                return 10
            elif c == "reboot":
                if yesno(tr("adm_reboot"), tr("adm_reboot_q"), default_no=True, tone="warn"):
                    run(["systemctl", "reboot"], check=False)
            elif c == "poweroff":
                if yesno(tr("adm_poweroff"), tr("adm_poweroff_q"), default_no=True, tone="err"):
                    run(["systemctl", "poweroff"], check=False)
            elif c == "logout":
                return 0
        except Cancel:
            continue
        except Exception as e:  # noqa: BLE001
            log(f"menu: {c}: {e}")
            msg(tr("adm_error"), f"{e}\n\n{tr('adm_details')}: {LOG}", tone="err")


# --------------------------------------------------------------------------
# the status screen on tty1, in the style of the EVE monitor: tabs at the
# top, boxes with a title, coloured states, the keys and a clock at the bottom
# --------------------------------------------------------------------------
TABS = ("status", "images", "log")
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
TONES = {"ok": "1;32", "warn": "1;33", "err": "1;31", "dim": "90", "bold": "1;97", "label": "37", "value": "97",
         "link": "36", "key": "30;47"}


def paint(text, tone):
    return f"\x1b[{TONES[tone]}m{text}\x1b[0m" if tone in TONES else text


def width_of(text):
    return len(ANSI_RE.sub("", text))


def cut(text, width):
    """Plain text shortened to width characters."""
    return text if len(text) <= width else text[:max(0, width - 1)] + "…"


def box(title, lines, width):
    """A box drawn with lines, the title in the top border. lines may carry colours."""
    inner = width - 4
    title = cut(title, width - 6)
    top = "┌─ " + paint(title, "bold") + " " + "─" * max(0, width - 5 - len(title)) + "┐"
    out = [top]
    for line in lines:
        out.append("│ " + line + " " * max(0, inner - width_of(line)) + " │")
    out.append("└" + "─" * (width - 2) + "┘")
    return out


def kv_lines(pairs, inner):
    """[(label, value, tone)] -> aligned lines of at most inner characters."""
    lw = min(max((len(k) for k, _, _ in pairs), default=0), inner // 2)
    return [paint(f"{cut(k, lw):<{lw}}", "label") + "  " + paint(cut(v, inner - lw - 2), tone or value_tone(v))
            for k, v, tone in pairs]


def value_tone(value):
    """Addresses (URLs, shares, IPs) in cyan, like links; the rest plain white."""
    return "link" if re.match(r"^(https?://|\\\\|\d+\.\d+\.\d+\.\d+)", value) else "value"


def service_tone(state):
    return {"running": "ok", "restarting": "warn", "created": "warn"}.get(state, "err")


def entry_state(e, activity):
    if e.get("error"):
        return tr("adm_img_error"), "err"
    if not e.get("netboot_ok"):
        return tr("adm_img_not_netboot"), "warn"
    return tr("adm_img_ready"), "ok"


def dashboard(tab, info, cols, lines_):
    """The status screen as a list of lines (with colours) of at most cols characters."""
    width = min(cols, 200)
    inner = width - 4
    head = paint(f" {PRODUCT} ", "bold") + " "
    for i, t in enumerate(TABS):
        name = f" {tr('adm_tab_' + t)} "
        head += f"\x1b[30;47m{name}\x1b[0m" if i == tab else name
        head += paint("│", "dim")
    host = f"{info['hostname']}  {info['version']} "
    if width_of(head) + len(host) < width:
        head += " " * (width - width_of(head) - len(host)) + paint(host, "dim")
    body = []
    if TABS[tab] == "status":
        body += box(tr("adm_box_server"), kv_lines(status_rows(info), inner), width)
        if info["configured"]:
            sip = info["server_ip"]
            body += box(tr("adm_box_dhcp"), kv_lines([
                ("next-server", sip, ""),
                (tr("adm_st_boot_file") + " x86_64", "eve-x86_64.efi", ""),
                (tr("adm_st_boot_file") + " arm64", "eve-arm64.efi", "")], inner), width)
            pairs = [(x, info["services"].get(x, "missing"), service_tone(info["services"].get(x, "missing")))
                     for x in ("sync", "tftp", "web")]
            act = info.get("activity") or {}
            if act.get("state") in ("downloading", "importing"):
                pairs.append((tr("adm_st_activity"), f"{act.get('item', '')} {act.get('percent', 0)}%", "warn"))
            pairs += [(tr("adm_st_installers"), tr("adm_st_installers_value", n=info["ready"],
                                                   date=info["github_checked"] or "-"),
                       "ok" if info["ready"] else "warn"),
                      (tr("adm_st_disk"), tr("adm_st_disk_value", used=f"{info['disk_used']:.1f}",
                                             free=f"{info['disk_free']:.1f}"),
                       "err" if info["disk_free"] < 2 else "")]
            if info["reboot_required"]:
                pairs.append((tr("adm_st_updates"), tr("adm_st_reboot_needed"), "warn"))
            body += box(tr("adm_box_services"), kv_lines(pairs, inner), width)
        if info["last_error"]:
            body += box(tr("adm_st_last_error"), [paint(cut(info["last_error"], inner), "err")], width)
    elif TABS[tab] == "images":
        entries = info.get("entries") or []
        rows_ = []
        for e in entries:
            name = (e.get("tag") or "") if e.get("source") == "github" else (e.get("name") or e.get("file") or "")
            if e.get("source") == "local" and e.get("release"):
                name = f"{e['release']}  {name}"      # the EVE-OS version from the ISO, then its file
            src = "GitHub" if e.get("source") == "github" else tr("src_local")
            state, tone = entry_state(e, info.get("activity"))
            rows_.append((name, e.get("arch") or "?", e.get("variant") or "", src, state, tone))
        nw = max([len(tr("adm_col_name"))] + [len(r[0]) for r in rows_])
        vw = max(4, min(10, len(tr("th_variant"))))
        nw = min(nw, inner - 36 - vw)
        fmt = f"{{:<{nw}}}  {{:<6}} {{:<{vw}}} {{:<11}} "
        table = [paint(fmt.format(tr("adm_col_name"), cut(tr("th_arch"), 6), cut(tr("th_variant"), vw),
                                  cut(tr("adm_col_source"), 11)) + tr("adm_col_state"), "dim")]
        room = max(1, lines_ - 6)
        for r in rows_[:room]:
            table.append(fmt.format(cut(r[0], nw), r[1], r[2], cut(r[3], 11)) + paint(cut(r[4], inner - nw - 22 - vw), r[5]))
        if len(rows_) > room:
            table.append(paint(tr("adm_more", n=len(rows_) - room), "dim"))
        if not rows_:
            table.append(tr("adm_no_images"))
        body += box(tr("adm_tab_images"), table, width)
    else:
        room = max(1, lines_ - 4)
        log_lines = [cut(x, inner) for x in read(LOG).splitlines()[-room:]]
        body += box(tr("adm_tab_log") + f" ({LOG})", log_lines or ["-"], width)
    body = body[:max(0, lines_ - 2)]
    clock = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    # "Enter: log in │ ..." -> the key names highlighted, the separators dim
    keys = tr("adm_footer_keys")
    highlighted = re.sub(r"(^|│ )([^:│]+)(:)", lambda m: m.group(1) + paint(f" {m.group(2)} ", "key") + m.group(3),
                         keys).replace("│", paint("│", "dim"))
    if width_of(highlighted) + len(clock) + 2 > width:
        highlighted = cut(keys, width - len(clock) - 3)
    # one column short of the edge: "erase line" in the last column of the Linux
    # console would also erase the clock's last digit
    foot = " " + highlighted + " " * (width - width_of(highlighted) - len(clock) - 2) + paint(clock, "bold")
    filler = [""] * max(0, lines_ - 2 - len(body))
    return [head] + body + filler + [foot]


class Keys:
    """Single key presses from the console, without echo."""

    def __enter__(self):
        import termios
        self.fd = sys.stdin.fileno()
        try:
            self.old = termios.tcgetattr(self.fd)
        except termios.error:
            self.old = None
            return self
        new = termios.tcgetattr(self.fd)
        new[3] &= ~(termios.ECHO | termios.ICANON)
        termios.tcsetattr(self.fd, termios.TCSANOW, new)
        termios.tcflush(self.fd, termios.TCIFLUSH)
        return self

    def __exit__(self, *exc):
        import termios
        if self.old is not None:
            termios.tcsetattr(self.fd, termios.TCSANOW, self.old)

    def read(self, timeout):
        """'enter', 'left', 'right', a character, or None after timeout seconds."""
        import select
        if self.old is None:
            time.sleep(timeout)
            return None
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return None
        data = os.read(self.fd, 32)
        if b"\r" in data or b"\n" in data:
            return "enter"
        if data.startswith(b"\x1b[") or data.startswith(b"\x1bO"):
            last = data[-1:]
            return {b"C": "right", b"D": "left"}.get(last)
        if data == b"\t":
            return "right"
        return data[:1].decode("latin-1")


def status_screen():
    """The status with tabs until Enter is pressed."""
    tab, info, fetched = 0, None, 0.0
    sys.stdout.write("\x1b[?25l\x1b[2J")
    try:
        with Keys() as keys:
            while True:
                if info is None or time.time() - fetched > 5:
                    info, fetched = status_info(), time.time()
                cols, lines_ = shutil.get_terminal_size((80, 25))
                screen = dashboard(tab, info, cols, lines_)
                sys.stdout.write("\x1b[H" + "\n".join(line + "\x1b[K" for line in screen) + "\x1b[J")
                sys.stdout.flush()
                k = keys.read(1.0)
                if k == "enter":
                    return
                if k == "right":
                    tab = (tab + 1) % len(TABS)
                elif k == "left":
                    tab = (tab - 1) % len(TABS)
                elif k in ("1", "2", "3"):
                    tab = int(k) - 1
                elif k in ("r", "R"):
                    info = None
    finally:
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[2J\x1b[H")
        sys.stdout.flush()


def console_keys():
    """Alt + left/right are plain arrow keys (switching tabs, as on EVE-OS's
    console) instead of switching to another virtual console, where a Linux
    login waits; Alt+F1..F6 still switch consoles."""
    lines = []
    for alt in ("alt", "altgr"):
        for n in range(4):
            for mods in itertools.combinations(("shiftl", "shiftr", "ctrll"), n):
                lines += [" ".join([alt, *mods, f"keycode {code} = {key}"]) for code, key in ((105, "Left"), (106, "Right"))]
    path = "/run/eve-netboot-arrows.kmap"
    try:
        write(path, "\n".join(lines) + "\n")
        run(["loadkeys", path], check=False, quiet=True)
    except OSError:
        pass


def console():
    """tty1: wizard until set up, then the status screen and a login to the menu."""
    os.environ.setdefault("TERM", "linux")
    console_keys()
    # settings from cloud-init are applied by "eve-netboot boot": wait for it, or
    # the wizard would start on a VM that is about to be set up
    started = time.time()
    while not os.path.exists(BOOT_DONE) and time.time() - started < 900:
        print(f"\033[2J\033[H\n  {paint(PRODUCT, 'bold')}\n\n  {tr('adm_starting')}", flush=True)
        time.sleep(3)
    while True:
        if not is_configured():
            wizard()
            continue
        status_screen()
        try:
            if not admin_has_password():
                pw = ask_password(tr("adm_admin_password"))
                run(["chpasswd"], input=f"{ADMIN}:{pw}\n")
                continue
            pw = ask(tr("adm_login"), tr("adm_login_text", user=ADMIN), password=True, cancel=tr("adm_btn_cancel"))
        except Cancel:
            continue
        if not check_password(ADMIN, pw):
            log("console: wrong admin password")
            time.sleep(3)
            msg(tr("adm_login"), tr("adm_wrong_password"), tone="err")
            continue
        if menu() == 10:
            print("\033[2J\033[H" + tr("adm_shell_hint") + "\n", flush=True)
            subprocess.run(["su", "-w", "ENI_NO_MENU", "-", ADMIN],
                           env=dict(os.environ, ENI_NO_MENU="1"))


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------
def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if os.geteuid() != 0 and cmd not in ("help", "--help"):
        os.execvp("sudo", ["sudo", "--", os.path.abspath(argv[0]), *argv[1:]])
    if cmd == "boot":
        cmd_boot()
    elif cmd == "console":
        console()
    elif cmd == "menu":
        return menu()
    elif cmd == "status":
        cmd_status()
    elif cmd == "apply":
        s = load_settings()
        errors = validate(s)
        if errors:
            print("\n".join(errors), file=sys.stderr)
            return 1
        apply(s)
        print("applied")
    elif cmd == "logs":
        os.execvp("docker", ["docker", "compose", "--project-directory", STACK, "-p", "eve-netboot",
                             "logs", "-f", "--tail", "100", *argv[2:]])
    elif cmd == "sync":
        compose("restart", "sync")
        print("sync restarted - see: eve-netboot logs sync")
    elif cmd == "update-system":
        ok, reboot, text = update_system()
        print(text)
        return 0 if ok else 1
    elif cmd == "update-app":
        ok, text = update_app()
        print(text)
        return 0 if ok else 1
    elif cmd == "export":
        cmd_export()
    elif cmd == "web":
        sys.path.insert(0, LIB)
        import eve_netboot_web  # /usr/local/lib/eve-netboot/eve_netboot_web.py
        return eve_netboot_web.serve(sys.modules[__name__])
    else:
        print(__doc__)
        return 0 if cmd in ("help", "--help") else 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
