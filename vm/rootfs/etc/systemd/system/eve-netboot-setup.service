[Unit]
Description=EVE Netboot Installer appliance: apply settings and start the stack
# after cloud-init has fetched the user-data and applied users/passwords (when
# the hypervisor passes any). Not cloud-final.service: that one runs after
# multi-user.target, which waits for this unit (ordering cycle).
After=cloud-init-network.service cloud-config.service network-online.target docker.service systemd-networkd.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/eve-netboot boot
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
