# ===========================================================================
# EVE-Netboot-Installer - configuration
#   cp .env.example .env   and adjust. Only SERVER_IP is required.
#   Empty values fall back to the default shown in the comment.
#
#   Names:  ENI_*          settings of EVE-Netboot-Installer itself
#           EVE_DEFAULT_*  defaults of EVE-OS's own installation options
#           others         network, paths, iPXE
#   Before version 1.3 the ENI_* settings were called EVE_* (EVE_LANGUAGE,
#   EVE_ARCHES, ...). Those names still work; the sync log lists the ones
#   that are still in use.
# ===========================================================================

# ---------------------------------------------------------------- network --
# IP address of this host as seen by the machines that PXE boot. It ends up
# in the iPXE menu URLs, so it must be reachable from those machines.
SERVER_IP=192.168.1.10

# HTTP port for the menu, kernels, ISOs and the status page (default 8080)
HTTP_PORT=8080
# Interface address the HTTP port is published on (default 0.0.0.0 = all)
HTTP_BIND=
# Address:port the TFTP server listens on (default 0.0.0.0:69)
TFTP_LISTEN=

# ------------------------------------------------------------------ paths --
# Runtime data: www/ (mirror, menu, status page) and tftp/. Needs ~0.7 GB per
# mirrored release variant. Default ./data next to compose.yaml.
# Relative paths are relative to compose.yaml; use absolute paths when a
# compose manager keeps the stack file somewhere else.
DATA_DIR=./data

# Folder that is scanned (recursively, read-only) for your own EVE installer
# ISOs (volume id EVEISO) and *installer-net.tar files. Other ISOs are ignored.
IMPORT_DIR=./import
# How that folder is called in the menu and on the status page
# (default: "import folder", translated)
ENI_IMPORT_LABEL=

# Source checkout used to build the image (default: . = this repository).
# Set an absolute path when compose.yaml is not run from the checkout.
ENI_SRC_DIR=
# Image name; set to a registry image to pull instead of building
# (default eve-netboot-installer:latest)
ENI_IMAGE=

# --------------------------------------------------------------- language --
# Menu and status page language: en de fr es pt nl da no   (default en)
ENI_LANGUAGE=en

# ------------------------------------------------------------------- menu --
# standalone: the EVE menu is the top level; "exit" boots the local disk
# chained:    the menu is chained from another iPXE menu; "exit" goes back
ENI_MENU_MODE=standalone
# Seconds without a key press before the first menu boots the local disk
# (standalone) or goes back (chained). 0 = wait forever.
# (default 300 standalone, 0 chained)
ENI_MENU_TIMEOUT=

# ------------------------------------------------------- GitHub mirroring --
# Architectures and variants to mirror: amd64 arm64 / kvm k
ENI_ARCHES=amd64
ENI_FLAVOURS=kvm
# Mirror the newest patch release of the newest N LTS lines (default 3)
ENI_LTS_LINES=3
# Seconds between GitHub checks (default 86400 = daily, 0 = only at start;
# the import folder is watched either way)
ENI_SYNC_INTERVAL=86400
# Seconds between scans of IMPORT_DIR (default 60)
ENI_IMPORT_INTERVAL=60
# Source repository (default lf-edge/eve)
ENI_GITHUB_REPO=
# Optional GitHub token, only needed if the anonymous API limit (60 requests
# per hour per IP; one check uses ~4) is hit, e.g. behind a shared NAT. Use a
# fine-grained token without permissions; it is only sent to api.github.com.
# (Older versions used GITHUB_TOKEN; that name is no longer read from .env.)
ENI_GITHUB_TOKEN=

# ---------------------------------------------- installer option defaults --
# Starting values of the "Installation options" menu (all changeable at boot)
# eve_reboot_after_install
EVE_DEFAULT_REBOOT=1
# eve_soft_serial=<MAC address>
EVE_DEFAULT_SOFT_SERIAL=1
# eve_nuke_all_disks
EVE_DEFAULT_NUKE_ALL_DISKS=0
# none | ttyS0 | ttyS1 | ttyAMA0
EVE_DEFAULT_SERIAL=none
# e.g. sda, nvme0n1 (empty = installer decides)
EVE_DEFAULT_INSTALL_DISK=
# e.g. sdb or sdb,sdc (several = ZFS)
EVE_DEFAULT_PERSIST_DISK=
# controller hostname (empty = from the ISO)
EVE_DEFAULT_INSTALL_SERVER=
# extra kernel parameters
EVE_DEFAULT_EXTRA_ARGS=

# ------------------------------------------------------------------- iPXE --
# iPXE release built into the image (default v2.0.0)
IPXE_VERSION=
# Extra file names for the iPXE binaries in the TFTP root, space separated,
# e.g. to match a boot file name your DHCP server already hands out.
# eve-x86_64.efi and eve-arm64.efi are always present.
IPXE_ALIASES_X86_64=
IPXE_ALIASES_ARM64=

# ------------------------------------------------------------------- misc --
TZ=UTC
