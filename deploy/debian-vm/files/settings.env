# ===========================================================================
# EVE-Netboot-Installer Debian VM - settings
#   On the VM: /etc/eve-netboot/settings.env   (edit with: sudo eve-netboot config)
#   All options of the application are described in .env.example of the
#   EVE-Netboot-Installer repository; the most common ones are listed here.
# ===========================================================================

# ---- where the application comes from ------------------------------------
# git URL (cloned) or URL of a .tar.gz source archive
EVE_SOURCE=https://github.com/michiel-zededa/eve-netboot-installer.git
# branch or tag for git sources
EVE_SOURCE_REF=main

# ---- network ----------------------------------------------------------------
# "auto" = the VM's own IPv4 address (re-detected at every boot).
# Use a DHCP reservation or a fixed address so DHCP next-server stays valid.
SERVER_IP=auto
HTTP_PORT=8080

# ---- application ------------------------------------------------------------
EVE_LANGUAGE=en
EVE_ARCHES=amd64
EVE_FLAVOURS=kvm
EVE_LTS_LINES=3
EVE_MENU_TIMEOUT=300
EVE_DEFAULT_SERIAL=none
EVE_DEFAULT_INSTALL_SERVER=
TZ=UTC

# ---- your own installer ISOs ------------------------------------------------
# Folder on the VM that is scanned for EVE installer ISOs
IMPORT_DIR=/srv/eve-netboot/import
EVE_IMPORT_LABEL=import share
# Optional SMB share "eve-import" for that folder (yes/no)
SMB_IMPORT_SHARE=no
SMB_USER=eve
SMB_PASSWORD=
