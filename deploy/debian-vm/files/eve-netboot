#!/bin/bash
# ---------------------------------------------------------------------------
# eve-netboot - manage the EVE-Netboot-Installer compose stack on this VM
#
#   eve-netboot install   first-time setup (run by cloud-init)
#   eve-netboot start     (re)start the stack, re-detecting SERVER_IP if "auto"
#   eve-netboot stop      stop the stack (data is kept)
#   eve-netboot status    containers, IP, URLs, disk usage
#   eve-netboot logs [service]   follow logs (sync | tftp | web)
#   eve-netboot config    edit settings, then apply
#   eve-netboot update    fetch the newest source and rebuild
#   eve-netboot sync      check GitHub for new releases now
#
# Settings: /etc/eve-netboot/settings.env
# Source:   /opt/eve-netboot          Data: /srv/eve-netboot
# ---------------------------------------------------------------------------
set -euo pipefail

SETTINGS=/etc/eve-netboot/settings.env
SRC=/opt/eve-netboot
DATA=/srv/eve-netboot
LOG=/var/log/eve-netboot.log

msg()  { echo "[eve-netboot] $*" | tee -a "$LOG" >&2; }
die()  { msg "ERROR: $*"; exit 1; }

setting() {   # setting NAME [default]  -> value from settings.env
  local v
  v=$(sed -n "s/^$1=//p" "$SETTINGS" 2>/dev/null | tail -n1 | sed 's/^"\(.*\)"$/\1/')
  echo "${v:-${2:-}}"
}

primary_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'
}

compose() { docker compose --project-directory "$SRC" -f "$SRC/compose.yaml" --env-file "$SRC/.env" "$@"; }

install_docker() {
  if docker compose version >/dev/null 2>&1; then return; fi
  msg "installing Docker Engine + compose plugin"
  . /etc/os-release
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/${ID}/gpg" -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/${ID} ${VERSION_CODENAME} stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
}

fetch_source() {
  local source ref
  source=$(setting EVE_SOURCE)
  ref=$(setting EVE_SOURCE_REF main)
  [ -n "$source" ] || die "EVE_SOURCE is not set in $SETTINGS"
  case "$source" in
    *.tar.gz|*.tgz)
      msg "downloading source archive $source"
      rm -rf "$SRC.new" && mkdir -p "$SRC.new"
      curl -fsSL "$source" | tar xz -C "$SRC.new" --strip-components=1
      [ -f "$SRC.new/compose.yaml" ] || die "archive does not contain compose.yaml"
      rm -rf "$SRC.old"; [ -d "$SRC" ] && mv "$SRC" "$SRC.old"; mv "$SRC.new" "$SRC"; rm -rf "$SRC.old"
      ;;
    *)
      if [ -d "$SRC/.git" ]; then
        msg "updating git checkout ($ref)"
        git -C "$SRC" fetch --quiet origin "$ref"
        git -C "$SRC" checkout --quiet -B "$ref" FETCH_HEAD
      else
        msg "cloning $source ($ref)"
        rm -rf "$SRC"
        git clone --quiet --branch "$ref" "$source" "$SRC"
      fi
      ;;
  esac
}

write_env() {
  # .env for compose = settings.env with VM specific values filled in
  local ip
  ip=$(setting SERVER_IP auto)
  if [ "$ip" = "auto" ]; then
    ip=$(primary_ip)
    [ -n "$ip" ] || die "could not determine this VM's IP address; set SERVER_IP in $SETTINGS"
  fi
  mkdir -p "$DATA/www" "$DATA/tftp"
  if [ ! -d "$(setting IMPORT_DIR "$DATA/import")" ]; then
    mkdir -p "$(setting IMPORT_DIR "$DATA/import")"
    # let the admin user copy ISOs in with scp
    id eve >/dev/null 2>&1 && chown eve: "$(setting IMPORT_DIR "$DATA/import")"
  fi
  {
    echo "# generated by eve-netboot from $SETTINGS - edit that file instead"
    grep -v -E '^(SERVER_IP|DATA_DIR|IMPORT_DIR|EVE_SRC_DIR|EVE_SOURCE|EVE_SOURCE_REF|SMB_[A-Z_]+)=' "$SETTINGS" || true
    echo "SERVER_IP=$ip"
    echo "DATA_DIR=$DATA"
    echo "IMPORT_DIR=$(setting IMPORT_DIR "$DATA/import")"
    echo "EVE_SRC_DIR=$SRC"
  } > "$SRC/.env"
  chmod 0600 "$SRC/.env"
  echo "$ip"
}

setup_smb() {
  [ "$(setting SMB_IMPORT_SHARE no)" = "yes" ] || return 0
  local user pass dir
  user=$(setting SMB_USER eve); pass=$(setting SMB_PASSWORD)
  dir=$(setting IMPORT_DIR "$DATA/import")
  [ -n "$pass" ] || die "SMB_IMPORT_SHARE=yes needs SMB_PASSWORD"
  msg "setting up SMB share 'eve-import' for $dir"
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq samba >/dev/null
  id "$user" >/dev/null 2>&1 || useradd -M -s /usr/sbin/nologin "$user"
  chown "$user" "$dir"
  grep -q '^\[eve-import\]' /etc/samba/smb.conf || cat >> /etc/samba/smb.conf <<CONF

[eve-import]
   comment = EVE installer ISOs for EVE-Netboot-Installer
   path = $dir
   valid users = $user
   read only = no
   create mask = 0644
CONF
  printf '%s\n%s\n' "$pass" "$pass" | smbpasswd -s -a "$user" >/dev/null
  systemctl restart smbd
}

cmd_install() {
  [ -f "$SETTINGS" ] || die "missing $SETTINGS"
  install_docker
  fetch_source
  setup_smb
  systemctl daemon-reload
  systemctl enable eve-netboot.service
  cmd_start
  msg "installation finished"
}

cmd_start() {
  local ip
  ip=$(write_env)
  msg "starting stack (SERVER_IP=$ip) - the first start builds the image (~5 min)"
  compose up -d --build --remove-orphans 2>&1 | tee -a "$LOG" >/dev/null
  msg "status page: http://$ip:$(setting HTTP_PORT 8080)/"
}

cmd_stop()   { compose down; }
cmd_logs()   { compose logs -f --tail 100 ${1:+"$1"}; }
cmd_sync()   { compose restart sync; msg "sync restarted - see: eve-netboot logs sync"; }
cmd_update() { fetch_source; cmd_start; }
cmd_config() {
  "${EDITOR:-nano}" "$SETTINGS"
  setup_smb
  cmd_start
}
cmd_status() {
  local ip port
  ip=$(sed -n 's/^SERVER_IP=//p' "$SRC/.env" 2>/dev/null); port=$(setting HTTP_PORT 8080)
  echo "VM address : $(primary_ip)   (SERVER_IP in use: ${ip:-?})"
  echo "Status page: http://${ip:-$(primary_ip)}:$port/"
  echo "DHCP       : next-server ${ip:-?}, boot file eve-x86_64.efi"
  echo
  compose ps
  echo
  df -h "$DATA" | tail -n1 | awk '{print "Data disk  : " $3 " used, " $4 " free (" $5 ")"}'
}

# everything below needs root (docker, /etc, /srv)
[ "$(id -u)" -eq 0 ] || exec sudo -- "$0" "$@"

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  status)  shift; cmd_status "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  config)  shift; cmd_config "$@" ;;
  update)  shift; cmd_update "$@" ;;
  sync)    shift; cmd_sync "$@" ;;
  *) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
